    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>DanCI.Structural.Tests</RootNamespace>
    <AssemblyName>DanCI.Structural.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
