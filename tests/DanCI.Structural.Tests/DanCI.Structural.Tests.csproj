  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DanCI.Structural.Core\DanCI.Structural.Core.csproj" />
    <ProjectReference Include="..\..\src\DanCI.Structural.Eurocodes\DanCI.Structural.Eurocodes.csproj" />
    <ProjectReference Include="..\..\src\DanCI.Structural.Reinforcement\DanCI.Structural.Reinforcement.csproj" />
    <ProjectReference Include="..\..\src\DanCI.Structural.Engine\DanCI.Structural.Engine.csproj" />
    <ProjectReference Include="..\..\src\DanCI.Structural.Documentation\DanCI.Structural.Documentation.csproj" />
  </ItemGroup>
</Project>
