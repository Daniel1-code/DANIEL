<Window x:Class="DanCI.BOQ.UI.Views.BoqWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DanCI.BOQ.UI.ViewModels"
        Title="DanCI — Métré &amp; BOQ" Width="1280" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="12"
        Background="#FF070D1A" Foreground="#FFE6F1FF">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="DanciBlue" Color="#FF00E5FF"/>
        <SolidColorBrush x:Key="DanciOrange" Color="#FFFF8A00"/>
        <!-- Texte facultatif : masque quand il est vide (pas de ligne blanche). -->
        <Style x:Key="Optional" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="GroupHeader" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <Expander IsExpanded="True" BorderThickness="0" Background="#FF13233D">
                            <Expander.Header>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource DanciBlue}" Margin="2"/>
                            </Expander.Header>
                            <ItemsPresenter/>
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="8">
        <!-- Portee et actions -->
        <Border DockPanel.Dock="Top" Background="#FF0F1A2E" BorderBrush="#FF1E3A5F" BorderThickness="1" Padding="8" Margin="0,0,0,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="Portée :" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                    <ComboBox Width="160" ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding SelectedScope}" DisplayMemberPath="Label" VerticalAlignment="Center"/>
                    <Expander Header="Niveaux" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="Aucun niveau coché = tous les niveaux.">
                        <Border Background="#FF0F1A2E" BorderBrush="#FF1E3A5F" BorderThickness="1" Padding="4" MaxHeight="220">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Levels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Expander>
                    <Button Content="Analyser" Command="{Binding AnalyzeCommand}" Margin="16,0,4,0" FontWeight="SemiBold"
                            Tag="primary"/>
                    <Button Content="Exporter Excel / PDF" Command="{Binding ExportCommand}"
                            ToolTip="Classeur Excel (page de garde, BOQ à formules vivantes, récapitulatif, détail du métré, audit, hypothèses), PDF prêt à signer, et CSV bruts."/>
                    <Button Content="Écrire les codes dans le modèle" Command="{Binding WriteParametersCommand}"
                            ToolTip="Écrit DanCI_BOQ_Code et DanCI_BOQ_Lot sur les éléments métrés du modèle hôte. Seule action qui MODIFIE le modèle : confirmation demandée, une seule annulation (Ctrl+Z)."/>
                </StackPanel>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Foreground="#FF8AA4C8" Margin="12,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- Phase, demolitions, liens -->
        <Border DockPanel.Dock="Top" Background="#FF0F1A2E" BorderBrush="#FF1E3A5F" BorderThickness="1" Padding="8,4" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Phase métrée :" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                <ComboBox Width="220" ItemsSource="{Binding Phases}" SelectedItem="{Binding SelectedPhase}" VerticalAlignment="Center"
                          ToolTip="Seuls les éléments CRÉÉS dans cette phase et non démolis sont comptés (les existants sont exclus)."/>
                <CheckBox Content="Démolitions de la phase (lot séparé)" IsChecked="{Binding IncludeDemolition}" VerticalAlignment="Center" Margin="12,0,0,0"
                          ToolTip="Compte aussi les éléments démolis dans la phase, dans le lot DEM."/>
                <Expander Header="Liens RVT" Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="Liens chargés à inclure au métré (chaque instance est comptée).">
                    <Border Background="#FF0F1A2E" BorderBrush="#FF1E3A5F" BorderThickness="1" Padding="4" MaxHeight="200">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Links}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Expander>
                <TextBlock Text="{Binding ProjectFilePath, StringFormat=Projet : {0}}" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="#FF8AA4C8" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
            </StackPanel>
        </Border>

        <!-- Bibliotheque de prix du projet -->
        <Border DockPanel.Dock="Top" Background="#FF0F1A2E" BorderBrush="#FF1E3A5F" BorderThickness="1" Padding="8,4" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Prix :" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding PriceLibraryLabel}" VerticalAlignment="Center" MinWidth="200" TextTrimming="CharacterEllipsis" MaxWidth="360"
                           ToolTip="{Binding PriceLibraryPath}"/>
                <Button Content="Choisir…" Command="{Binding ChoosePriceLibraryCommand}"
                        ToolTip="Bibliothèque de prix du projet (par client, par ville) : fichier .json, ou classeur .xlsx à importer."/>
                <Button Content="Installation" Command="{Binding ResetPriceLibraryCommand}" ToolTip="Revenir à la bibliothèque de l'installation."/>
                <Button Content="Saisir les prix…" Command="{Binding ShowSettingsCommand}"
                        ToolTip="Ouvre l'onglet « Paramètres du projet » : prix unitaires, TVA, majorations, identité, page de garde."/>
                <Button Content="Modèle Excel des prix…" Command="{Binding PriceTemplateCommand}"
                        ToolTip="Exporte tous les articles (PU vides s'il n'y a pas de prix) dans un classeur à remplir, puis à réimporter avec « Choisir… »."/>
            </StackPanel>
        </Border>

        <!-- Pied de devis -->
        <Border DockPanel.Dock="Bottom" Background="#FF0F1A2E" BorderBrush="#FF1E3A5F" BorderThickness="1" Padding="8" Margin="0,6,0,0">
            <StackPanel>
                <TextBlock Text="{Binding IncompleteText}" Foreground="#FFFF4D6D" FontWeight="SemiBold"
                           Visibility="{Binding IsIncomplete, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4"/>
                <WrapPanel>
                    <TextBlock Margin="0,0,24,0"><Run Text="Total travaux HT : "/><Run Text="{Binding WorksTotal, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                    <TextBlock Text="{Binding Markups}" Margin="0,0,24,0"/>
                    <TextBlock Margin="0,0,24,0"><Run Text="Total HT : "/><Run Text="{Binding TotalExcludingVat, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                    <TextBlock Text="{Binding Vat}" Margin="0,0,24,0"/>
                    <TextBlock Margin="0,0,8,0" Foreground="{StaticResource DanciBlue}" FontSize="14">
                        <Run Text="Total TTC : "/><Run Text="{Binding TotalIncludingVat, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock Text="{Binding SecondaryTotal}" VerticalAlignment="Center"/>
                </WrapPanel>
                <TextBlock Text="{Binding ReliabilityText}" Foreground="{StaticResource DanciOrange}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding FooterText}" Foreground="#FF8AA4C8" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <TabControl SelectedIndex="{Binding SelectedTab}">
            <!-- Tableau de bord de pilotage (theme nuit) -->
            <TabItem Header="Tableau de bord">
                <Border Background="#FF070D1A" Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel DataContext="{Binding Dashboard}">
                            <DockPanel Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <TextBlock Text="NOTE DE SANTÉ" Foreground="#FF8AA4C8" FontSize="10" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding ScoreText}" Foreground="{Binding ScoreColor}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right">
                                        <TextBlock.Effect><DropShadowEffect Color="#FF00E5FF" BlurRadius="14" ShadowDepth="0" Opacity="0.6"/></TextBlock.Effect>
                                    </TextBlock>
                                    <Border Height="4" Width="180" Background="#FF1E3A5F" HorizontalAlignment="Right">
                                        <Border Height="4" Width="{Binding ScoreAngleWidth}" Background="{Binding ScoreColor}" HorizontalAlignment="Left"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="TABLEAU DE BORD DE PILOTAGE" Foreground="#FF00E5FF" FontSize="20" FontWeight="Bold">
                                        <TextBlock.Effect><DropShadowEffect Color="#FF00E5FF" BlurRadius="16" ShadowDepth="0" Opacity="0.7"/></TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Title}" Foreground="#FF8AA4C8" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding Tiles}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="204" Margin="0,0,8,8" Padding="10" Background="#FF0F1A2E" BorderBrush="#FF1E3A5F" BorderThickness="1" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" Foreground="#FF8AA4C8" FontSize="10"/>
                                                <TextBlock Text="{Binding Value}" Foreground="{Binding Color}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <Border Height="4" Width="180" HorizontalAlignment="Left" Background="#FF1E3A5F" Margin="0,4,0,2"
                                                        Visibility="{Binding HasGauge, Converter={StaticResource BoolToVis}}">
                                                    <Border Height="4" Width="{Binding GaugeWidth}" HorizontalAlignment="Left" Background="{Binding Color}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Sub}" Foreground="#FF8AA4C8" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#FF0F1A2E" BorderBrush="#FF1E3A5F" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="RÉPARTITION PAR LOT" Foreground="#FF00E5FF" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <ItemsControl ItemsSource="{Binding Lots}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="270"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="56"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Code}" Foreground="#FF8AA4C8"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Designation}" Foreground="#FFE6F1FF" TextTrimming="CharacterEllipsis"/>
                                                        <Border Grid.Column="2" Height="8" Width="260" HorizontalAlignment="Left" Background="#FF1E3A5F" CornerRadius="4">
                                                            <Border Height="8" Width="{Binding BarWidth}" HorizontalAlignment="Left" Background="{Binding Color}" CornerRadius="4">
                                                                <Border.Effect><DropShadowEffect Color="#FF00E5FF" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
                                                            </Border>
                                                        </Border>
                                                        <TextBlock Grid.Column="3" Text="{Binding Amount}" Foreground="#FFE6F1FF" HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding Share}" Foreground="#FF00E5FF" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="#FF0F1A2E" BorderBrush="#FF1E3A5F" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="VOYANTS" Foreground="#FF00E5FF" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <ItemsControl ItemsSource="{Binding Signals}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,3">
                                                        <Ellipse Width="9" Height="9" Fill="{Binding Color}" DockPanel.Dock="Left" Margin="0,4,8,0" VerticalAlignment="Top">
                                                            <Ellipse.Effect><DropShadowEffect Color="#FFFFFFFF" BlurRadius="8" ShadowDepth="0" Opacity="0.35"/></Ellipse.Effect>
                                                        </Ellipse>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" Foreground="#FFE6F1FF" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Detail}" Foreground="#FF8AA4C8" FontSize="11" TextWrapping="Wrap" Style="{StaticResource Optional}"/>
                                                            <TextBlock Text="{Binding Action}" Foreground="{Binding Color}" FontSize="11" TextWrapping="Wrap" Style="{StaticResource Optional}"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#FF0F1A2E" BorderBrush="#FF1E3A5F" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="PARETO — LES ARTICLES QUI FONT LE DEVIS" Foreground="#FF00E5FF" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <ItemsControl ItemsSource="{Binding Pareto}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="24"/>
                                                            <ColumnDefinition Width="56"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="130"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Rank}" Foreground="#FFFF8A00" FontWeight="Bold"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Code}" Foreground="#FF8AA4C8"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Designation}" Foreground="#FFE6F1FF" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Amount}" Foreground="#FFE6F1FF" HorizontalAlignment="Right"/>
                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Border Height="6" Width="{Binding CumulativeWidth}" Background="#FFFF8A00" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,6,0" MaxWidth="80"/>
                                                            <TextBlock Text="{Binding Cumulative}" Foreground="#FFFF8A00"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding ParetoEmpty}" Foreground="#FFFFC233" TextWrapping="Wrap" Style="{StaticResource Optional}"/>
                                        <TextBlock Text="Barre orange : part cumulée du total des travaux." Foreground="#FF8AA4C8" FontSize="10" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="#FF0F1A2E" BorderBrush="#FF1E3A5F" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="QUANTITÉS CLÉS (NETTES)" Foreground="#FF00E5FF" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <ItemsControl ItemsSource="{Binding KeyQuantities}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="100"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" Foreground="#FFE6F1FF"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#FFE6F1FF" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Measured}" Foreground="{Binding MeasuredColor}" FontSize="11" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding MissingPricesText}" Foreground="#FFFF4D6D" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            <TextBlock Foreground="#FF8AA4C8" FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="Indicateurs calculés uniquement à partir du BOQ, de l'audit et du métré de la dernière analyse. La note de santé (prix 50, fiabilité 30, audit 20) aide au pilotage ; elle ne remplace pas la vérification du métreur. Le même tableau de bord figure dans le PDF et dans le classeur exportés."/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- BOQ -->
            <TabItem Header="BOQ">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="LinesGrid" ItemsSource="{Binding LinesView}" SelectedItem="{Binding SelectedLine}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              CanUserAddRows="False" SelectionMode="Single" EnableRowVirtualization="True"
                              ToolTip="Double-clic : sélectionner et zoomer les éléments dans Revit.">
                        <DataGrid.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding SelectLineCommand}" CommandParameter="{Binding SelectedItem, ElementName=LinesGrid}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource GroupHeader}"/>
                        </DataGrid.GroupStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUnclassified}" Value="True">
                                        <Setter Property="Background" Value="#FF3A2A12"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N°" Binding="{Binding Code}" Width="80"/>
                            <DataGridTextColumn Header="Désignation" Binding="{Binding Designation}" Width="*"/>
                            <DataGridTextColumn Header="Unité" Binding="{Binding Unit}" Width="50"/>
                            <DataGridTextColumn Header="Qté nette" Binding="{Binding NetQuantity, StringFormat=N3}" Width="90" ElementStyle="{StaticResource Number}"/>
                            <DataGridTextColumn Header="Coef." Binding="{Binding CoefficientFactor, StringFormat=0.####}" Width="60" ElementStyle="{StaticResource Number}"/>
                            <DataGridTextColumn Header="Quantité" Binding="{Binding Quantity, StringFormat=N2}" Width="90" ElementStyle="{StaticResource Number}"/>
                            <DataGridTextColumn Header="PU" Binding="{Binding UnitPrice, StringFormat=N2}" Width="90" ElementStyle="{StaticResource Number}"/>
                            <DataGridTextColumn Header="Montant" Binding="{Binding Amount, StringFormat=N2}" Width="110" ElementStyle="{StaticResource Number}"/>
                            <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="110"/>
                            <DataGridTextColumn Header="Élém." Binding="{Binding ElementCount}" Width="50" ElementStyle="{StaticResource Number}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#FF1E3A5F"/>
                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedLineInfo}" TextWrapping="Wrap" Margin="2,4" Foreground="#FF8AA4C8"/>
                        <DataGrid x:Name="DetailGrid" ItemsSource="{Binding Contributions}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single"
                                  ToolTip="Détail du métré. Double-clic : sélectionner et zoomer l'élément dans Revit.">
                            <DataGrid.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding SelectContributionCommand}" CommandParameter="{Binding SelectedItem, ElementName=DetailGrid}"/>
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ElementId" Binding="{Binding ElementId}" Width="80"/>
                                <DataGridTextColumn Header="Lien" Binding="{Binding Source}" Width="90"/>
                                <DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Width="120"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="160"/>
                                <DataGridTextColumn Header="Matériau" Binding="{Binding Material}" Width="140"/>
                                <DataGridTextColumn Header="Niveau" Binding="{Binding Level}" Width="90"/>
                                <DataGridTextColumn Header="Quantité" Binding="{Binding Value, StringFormat=N3}" Width="80" ElementStyle="{StaticResource Number}"/>
                                <DataGridTextColumn Header="Unité" Binding="{Binding Unit}" Width="45"/>
                                <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Règle" Binding="{Binding RuleId}" Width="100"/>
                                <DataGridTextColumn Header="Méthode / hypothèse" Binding="{Binding Method}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Audit -->
            <TabItem Header="{Binding AuditHeader}">
                <DataGrid x:Name="AuditGrid" ItemsSource="{Binding FindingsView}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single">
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding SelectFindingCommand}" CommandParameter="{Binding SelectedItem, ElementName=AuditGrid}"/>
                    </DataGrid.InputBindings>
                    <DataGrid.GroupStyle>
                        <GroupStyle ContainerStyle="{StaticResource GroupHeader}"/>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Sélectionner" MinWidth="80" Padding="4,1" Margin="2"
                                            Command="{Binding DataContext.SelectFindingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" IsEnabled="{Binding CanSelect}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Gravité" Binding="{Binding Severity}" Width="120"/>
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="170"/>
                        <DataGridTextColumn Header="Élém." Binding="{Binding ElementCount}" Width="50" ElementStyle="{StaticResource Number}"/>
                        <DataGridTextColumn Header="Constat" Binding="{Binding Message}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Forfaits -->
            <TabItem Header="Forfaits">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4">
                        <Button Content="Ajouter" Command="{Binding AddManualCommand}"/>
                        <Button Content="Supprimer" Command="{Binding RemoveManualCommand}" CommandParameter="{Binding SelectedItem, ElementName=ManualGrid}"/>
                        <Button Content="Enregistrer et recalculer" Command="{Binding SaveManualCommand}" FontWeight="SemiBold"
                                ToolTip="Enregistre les forfaits dans le fichier projet .danciboq.json et recalcule le BOQ sans réanalyser la maquette."/>
                        <TextBlock Text="Lignes non métrables (installation de chantier, études, essais…), conservées dans le fichier projet." VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#FF8AA4C8"/>
                    </StackPanel>
                    <DataGrid x:Name="ManualGrid" ItemsSource="{Binding ManualLines}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Lot" Binding="{Binding Lot, UpdateSourceTrigger=LostFocus}" Width="50"/>
                            <DataGridTextColumn Header="Code (facultatif)" Binding="{Binding Code}" Width="100"/>
                            <DataGridTextColumn Header="Désignation" Binding="{Binding Designation}" Width="*"/>
                            <DataGridComboBoxColumn Header="Unité" SelectedItemBinding="{Binding Unit}" Width="60">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox"><Setter Property="ItemsSource" Value="{Binding DataContext.UnitChoices, RelativeSource={RelativeSource AncestorType=Window}}"/></Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox"><Setter Property="ItemsSource" Value="{Binding DataContext.UnitChoices, RelativeSource={RelativeSource AncestorType=Window}}"/></Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                            <DataGridTextColumn Header="Quantité" Binding="{Binding Quantity}" Width="80"/>
                            <DataGridTextColumn Header="PU" Binding="{Binding UnitPrice, TargetNullValue=''}" Width="90"/>
                            <DataGridComboBoxColumn Header="Devise" SelectedItemBinding="{Binding Currency}" Width="60">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox"><Setter Property="ItemsSource" Value="{Binding DataContext.CurrencyChoices, RelativeSource={RelativeSource AncestorType=Window}}"/></Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox"><Setter Property="ItemsSource" Value="{Binding DataContext.CurrencyChoices, RelativeSource={RelativeSource AncestorType=Window}}"/></Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                            <DataGridTextColumn Header="Justification" Binding="{Binding Justification}" Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Validation (etape 8) -->
            <TabItem Header="Validation">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource DanciBlue}" Text="Validation du métré (protocole VALIDATION.md)"/>
                        <TextBlock Margin="0,4,0,12" TextWrapping="Wrap"><Run Text="Empreinte du métré de la dernière analyse : "/><Run Text="{Binding Fingerprint, Mode=OneWay}" FontWeight="Bold"/><Run Text=" — deux analyses du même modèle (Revit 2026 et 2027) doivent donner la même."/></TextBlock>

                        <TextBlock FontWeight="SemiBold" Text="1. Comparer au métré manuel (cible : écart inférieur à 2 % sur le béton et l'acier)"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,6" Foreground="#FF8AA4C8"
                                   Text="Générez le gabarit, faites-le remplir à la main par le métreur (les quantités du modèle n'y figurent volontairement pas), puis comparez. Le rapport donne l'écart par élément, par article et par nature, et les pistes d'explication de chaque écart."/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Content="Générer le gabarit de métré manuel" Command="{Binding ValidationTemplateCommand}"/>
                            <Button Content="Comparer au gabarit rempli…" Command="{Binding CompareManualCommand}" FontWeight="SemiBold"/>
                        </StackPanel>

                        <TextBlock FontWeight="SemiBold" Text="2. Reproductibilité entre versions de Revit"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,6" Foreground="#FF8AA4C8"
                                   Text="Analysez le même fichier dans Revit 2026 puis 2027 (même portée, même phase, même configuration), exportez, puis comparez les deux fichiers « …_metre_brut.csv ». Toute différence est listée quantité par quantité."/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Comparer deux métrés bruts (CSV)…" Command="{Binding CompareRunsCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Exclus -->
            <TabItem Header="{Binding ExcludedHeader}">
                <DataGrid x:Name="ExcludedGrid" ItemsSource="{Binding Excluded}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single"
                          ToolTip="Quantités écartées du métré, avec leur motif. Double-clic : sélectionner dans Revit.">
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding SelectExcludedCommand}" CommandParameter="{Binding SelectedItem, ElementName=ExcludedGrid}"/>
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ElementId" Binding="{Binding ElementId}" Width="90"/>
                        <DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Width="140"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="180"/>
                        <DataGridTextColumn Header="Nature" Binding="{Binding Kind}" Width="110"/>
                        <DataGridTextColumn Header="Quantité" Binding="{Binding Value}" Width="100"/>
                        <DataGridTextColumn Header="Motif" Binding="{Binding Reason}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Parametres du projet -->
            <TabItem Header="Paramètres du projet">
                <DockPanel DataContext="{Binding Settings}">
                    <Border DockPanel.Dock="Bottom" Background="#FF0F1A2E" BorderBrush="#FF1E3A5F" BorderThickness="1" Padding="8" Margin="0,6,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Enregistrer les paramètres du projet" FontWeight="SemiBold"
                                    Tag="primary" Padding="16,6"
                                    Command="{Binding DataContext.SaveSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="Écrit le fichier projet .danciboq.json (et la bibliothèque de prix du projet si des prix ont changé), puis recalcule le BOQ. Le modèle Revit n'est PAS modifié."/>
                            <TextBlock TextWrapping="Wrap" Foreground="#FF8AA4C8" VerticalAlignment="Center"
                                       Text="Tant que vous n'avez pas cliqué sur « Enregistrer », le BOQ et les exports gardent les paramètres précédents. Un champ d'identité vide reprend la valeur des Informations sur le projet de Revit."/>
                        </DockPanel>
                    </Border>
                    <TabControl TabStripPlacement="Left">
                        <TabItem Header="Identité du projet">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="10">
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock" x:Key="Lbl">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="0,3,8,3"/>
                                        </Style>
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*" MaxWidth="420"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*" MaxWidth="420"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="0" Text="Nom du projet"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Revit.Name}"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="1" Text="Objet du devis"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Purpose}" ToolTip="Ex. : Construction d'un immeuble R+3 à usage de bureaux"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="2" Text="N° de projet"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Number}" ToolTip="{Binding Revit.Number}"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="3" Text="Référence du devis"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding QuoteReference}"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="4" Text="Indice de révision"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Revision}" ToolTip="A, B, C…"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="5" Text="Date du devis"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding IssueDate}" ToolTip="{Binding Revit.IssueDate}"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="6" Text="Statut"/>
                                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Status}" ToolTip="Ex. : APD, DCE, Offre"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="7" Text="Surface de référence (m²)"/>
                                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding ReferenceArea}" ToolTip="Pour le coût TTC au m² du tableau de bord."/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="8" Text="Nature de la surface"/>
                                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding ReferenceAreaLabel}" ToolTip="Ex. : surface de plancher, SHON"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="9" Text="Notes (pied de devis)"/>
                                    <TextBox Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44"/>

                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="0" Grid.Column="3" Text="Maître d'ouvrage"/>
                                    <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding Client}" ToolTip="{Binding Revit.Client}"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="1" Grid.Column="3" Text="Maître d'œuvre / architecte"/>
                                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Architect}"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="2" Grid.Column="3" Text="Bureau d'études"/>
                                    <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding Engineer}"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="3" Grid.Column="3" Text="Entreprise"/>
                                    <TextBox Grid.Row="3" Grid.Column="4" Text="{Binding Contractor}"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="4" Grid.Column="3" Text="Lieu"/>
                                    <TextBox Grid.Row="4" Grid.Column="4" Text="{Binding Location}" ToolTip="{Binding Revit.Location}"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="5" Grid.Column="3" Text="Établi par"/>
                                    <TextBox Grid.Row="5" Grid.Column="4" Text="{Binding Author}" ToolTip="{Binding Revit.Author}"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="6" Grid.Column="3" Text="Vérifié par"/>
                                    <TextBox Grid.Row="6" Grid.Column="4" Text="{Binding CheckedBy}"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="7" Grid.Column="3" Text="Validité de l'offre (jours)"/>
                                    <TextBox Grid.Row="7" Grid.Column="4" Text="{Binding ValidityDays}"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="8" Grid.Column="3" Text="Délai d'exécution"/>
                                    <TextBox Grid.Row="8" Grid.Column="4" Text="{Binding ExecutionTime}"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="10" Text="Conditions de paiement"/>
                                    <TextBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding PaymentTerms}"/>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Devis : TVA, devise">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10" MaxWidth="900" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding EstimateOrigin}" Foreground="#FF00E5FF" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <TextBlock Text="Devise du devis :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox Width="90" ItemsSource="{Binding Currencies}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Currency}"/>
                                        <TextBlock Text="TVA (%) :" VerticalAlignment="Center" Margin="24,0,6,0"/>
                                        <TextBox Width="70" Text="{Binding VatPercent}" ToolTip="RDC : 16"/>
                                    </WrapPanel>
                                    <GroupBox Header="Majorations de pied de devis (appliquées dans cet ordre)" Margin="0,12,0,0" Padding="6">
                                        <StackPanel>
                                            <DataGrid ItemsSource="{Binding Markups}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                                                      MinHeight="90" x:Name="MarkupGrid">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="110"/>
                                                    <DataGridTextColumn Header="Désignation" Binding="{Binding Designation}" Width="*"/>
                                                    <DataGridTextColumn Header="%" Binding="{Binding Percent}" Width="70"/>
                                                    <DataGridComboBoxColumn Header="Base" Width="160" SelectedValueBinding="{Binding Base}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                                                            ItemsSource="{x:Static vm:SettingsViewModel.MarkupBaseChoices}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Button Content="Ajouter" Command="{Binding AddMarkupCommand}"/>
                                                <Button Content="Supprimer" Command="{Binding RemoveMarkupCommand}" CommandParameter="{Binding SelectedItem, ElementName=MarkupGrid}"/>
                                                <TextBlock Text="« sur les travaux » : % du total des lots. « en cascade » : % du total cumulé (travaux + majorations précédentes)."
                                                           Foreground="#FF8AA4C8" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="520"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="Devise secondaire et taux de change (saisi à la main, daté)" Margin="0,12,0,0" Padding="6">
                                        <WrapPanel>
                                            <TextBlock Text="Afficher le TTC aussi en :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox Width="100" ItemsSource="{Binding SecondaryCurrencies}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding SecondaryCurrency}"/>
                                            <TextBlock Text="1 USD =" VerticalAlignment="Center" Margin="20,0,6,0"/>
                                            <TextBox Width="90" Text="{Binding Rate}"/>
                                            <TextBlock Text="CDF   du" VerticalAlignment="Center" Margin="6,0,6,0"/>
                                            <DatePicker Width="130" SelectedDate="{Binding RateDate}"/>
                                            <TextBlock Text="Source :" VerticalAlignment="Center" Margin="16,0,6,0"/>
                                            <TextBox Width="220" Text="{Binding RateSource}" ToolTip="Ex. : taux BCC du jour"/>
                                        </WrapPanel>
                                    </GroupBox>
                                    <Button Content="Revenir aux réglages de l'installation" Command="{Binding ResetEstimateCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                    <TextBlock Foreground="#FF8AA4C8" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Text="Les décimales et la quantité valorisée (brute ou nette) restent celles de config\parametres_devis.json : elles valent pour tous les projets."/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Prix unitaires">
                            <DockPanel Margin="6">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding PriceLibraryInfo}" Foreground="#FF00E5FF" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Text="Rechercher :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Width="220" Text="{Binding PriceFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                        <CheckBox Content="Seulement les articles sans prix" IsChecked="{Binding OnlyMissing}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                        <TextBlock Text="{Binding PricesSummary}" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold"/>
                                    </WrapPanel>
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Bottom" Foreground="#FF8AA4C8" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="PU vide = pas de prix : la ligne reste signalée « sans prix ». La décomposition (matériaux + main-d'œuvre + matériel) est facultative ; si elle est saisie, sa somme doit égaler le PU. Les prix par type (portes, diamètres…) de la bibliothèque sont conservés tels quels. Aucun prix n'est proposé par l'extension."/>
                                <DataGrid ItemsSource="{Binding PricesView}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          HeadersVisibility="Column" FrozenColumnCount="2" EnableRowVirtualization="True" x:Name="PriceGrid">
                                    <DataGrid.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name, StringFormat=LOT {0}}" FontWeight="SemiBold" Foreground="{StaticResource DanciBlue}" Margin="2,6,2,2"/>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </DataGrid.GroupStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" IsReadOnly="True" Width="70"/>
                                        <DataGridTextColumn Header="Désignation" Binding="{Binding Designation}" IsReadOnly="True" Width="*"/>
                                        <DataGridTextColumn Header="Unité" Binding="{Binding UnitSymbol}" IsReadOnly="True" Width="50"/>
                                        <DataGridTextColumn Header="PU" Binding="{Binding UnitPrice, UpdateSourceTrigger=LostFocus}" Width="90">
                                            <DataGridTextColumn.CellStyle>
                                                <Style TargetType="DataGridCell">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasNoPrice}" Value="True">
                                                            <Setter Property="Background" Value="#FF4A1F2A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.CellStyle>
                                        </DataGridTextColumn>
                                        <DataGridComboBoxColumn Header="Devise" SelectedItemBinding="{Binding Currency}" Width="64"
                                                                ItemsSource="{x:Static vm:SettingsViewModel.PriceCurrencies}"/>
                                        <DataGridTemplateColumn Header="Date du prix" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Date, StringFormat=dd/MM/yyyy}" Margin="2"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <DatePicker SelectedDate="{Binding Date, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="160"/>
                                        <DataGridTextColumn Header="Matériaux" Binding="{Binding Materials}" Width="76"/>
                                        <DataGridTextColumn Header="Main-d'œuvre" Binding="{Binding Labour}" Width="84"/>
                                        <DataGridTextColumn Header="Matériel" Binding="{Binding Equipment}" Width="70"/>
                                        <DataGridTextColumn Header="Prix par type" Binding="{Binding SpecificLabel}" IsReadOnly="True" Width="150"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="Page de garde">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10" MaxWidth="900" HorizontalAlignment="Left">
                                    <WrapPanel>
                                        <TextBlock Text="Style :" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                                        <ComboBox Width="320" ItemsSource="{Binding Themes}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Theme}"/>
                                    </WrapPanel>
                                    <TextBlock Text="Le style s'applique à la page de garde et au tableau de bord du PDF et du classeur. Les pages du BOQ restent sur fond blanc (impression, signature)."
                                               Foreground="#FF8AA4C8" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                    <WrapPanel Margin="0,0,0,8">
                                        <TextBlock Text="Sous-titre :" VerticalAlignment="Center" Margin="0,0,6,0" Width="150"/>
                                        <TextBox Width="460" Text="{Binding Subtitle}" ToolTip="Ex. : Dossier d'appel d'offres — Phase APD. Vide : l'objet du devis."/>
                                    </WrapPanel>
                                    <GroupBox Header="Image du projet (rendu, perspective, photo) — sur la page générée" Padding="6" Margin="0,0,0,8">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Retirer" Command="{Binding ClearImageCommand}" CommandParameter="image"/>
                                            <Button DockPanel.Dock="Right" Content="Choisir…" Command="{Binding ChooseProjectImageCommand}"/>
                                            <TextBlock Text="{Binding ProjectImage, TargetNullValue='(aucune)'}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </GroupBox>
                                    <GroupBox Header="Page de garde réalisée à part (PNG/JPG A4 portrait) — remplace la page générée" Padding="6" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Retirer" Command="{Binding ClearImageCommand}" CommandParameter="page"/>
                                                <Button DockPanel.Dock="Right" Content="Choisir…" Command="{Binding ChooseImportedPageCommand}"/>
                                                <TextBlock Text="{Binding ImportedPage, TargetNullValue='(aucune : page générée)'}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <TextBlock Foreground="#FF8AA4C8" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Text="Pour une page conçue dans un autre logiciel (Canva, Photoshop, InDesign…) : exportez-la en PNG ou JPG au format A4 portrait (au moins 1240 × 1754 pixels) et choisissez-la ici. Retirez-la pour revenir à la page générée."/>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="Logo du projet (facultatif ; sinon config\logo.png)" Padding="6">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Retirer" Command="{Binding ClearImageCommand}" CommandParameter="logo"/>
                                            <Button DockPanel.Dock="Right" Content="Choisir…" Command="{Binding ChooseLogoCommand}"/>
                                            <TextBlock Text="{Binding Logo, TargetNullValue='(logo de l&#x2019;installation)'}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </GroupBox>
                                    <TextBlock Foreground="#FF8AA4C8" TextWrapping="Wrap" Margin="0,10,0,0"
                                               Text="Les images placées dans le dossier du projet (à côté du .rvt) y sont référencées en chemin relatif : le dossier reste déplaçable. Une image introuvable à l'export est signalée, le document est produit sans elle."/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
