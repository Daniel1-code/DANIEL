<Window x:Class="DanCI.BOQ.UI.Views.BoqWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DanCI.BOQ.UI.ViewModels"
        Title="DanCI — Métré &amp; BOQ" Width="1280" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="12"
        Background="#FF070D1A" Foreground="#FFE6F1FF">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <vm:LotColorConverter x:Key="LotColor"/>
        <vm:PathGeometryConverter x:Key="PathGeo"/>
        <!-- Colonnes chiffrees en couleur : PU ambre, montant vert, quantite claire. -->
        <Style x:Key="Price" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="#FFFFC233"/>
        </Style>
        <Style x:Key="Amount" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="#FF21E6A1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="QuantityStrong" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding StatusColor}"/>
        </Style>
        <SolidColorBrush x:Key="DanciBlue" Color="#FF00E5FF"/>
        <SolidColorBrush x:Key="DanciOrange" Color="#FFFF8A00"/>
        <!-- Texte facultatif : masque quand il est vide (pas de ligne blanche). -->
        <Style x:Key="Optional" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Fiche societe (client du projet, ou notre entreprise) : coordonnees, mentions legales, logo. -->
        <DataTemplate x:Key="PartyForm">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10" MaxWidth="980" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#FFFF8A00"/>
                    <TextBlock Text="{Binding Hint}" Foreground="#FF8AA4C8" TextWrapping="Wrap" Margin="0,2,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*" MaxWidth="330"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*" MaxWidth="330"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,3,8,3"/></Style>
                        </Grid.Resources>
                        <TextBlock Grid.Row="0" Text="Sigle / nom court"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ShortName}"/>
                        <TextBlock Grid.Row="1" Text="Raison sociale / nom"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name}"/>
                        <TextBlock Grid.Row="2" Text="Activité"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Activity}"/>
                        <TextBlock Grid.Row="3" Text="Adresse"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Address}"/>
                        <TextBlock Grid.Row="4" Text="Ville"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding City}"/>
                        <TextBlock Grid.Row="5" Text="Pays"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Country}"/>
                        <TextBlock Grid.Row="6" Text="Personne à contacter"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Contact}"/>
                        <TextBlock Grid.Row="7" Text="Fonction"/>
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding ContactRole}"/>

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Téléphone"/>
                        <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding Phone}"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="E-mail"/>
                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Email}"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Site web"/>
                        <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding Website}"/>
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="RCCM"/>
                        <TextBox Grid.Row="3" Grid.Column="4" Text="{Binding Rccm}"/>
                        <TextBlock Grid.Row="4" Grid.Column="3" Text="Id. Nat."/>
                        <TextBox Grid.Row="4" Grid.Column="4" Text="{Binding IdNat}"/>
                        <TextBlock Grid.Row="5" Grid.Column="3" Text="NIF"/>
                        <TextBox Grid.Row="5" Grid.Column="4" Text="{Binding Nif}"/>
                        <TextBlock Grid.Row="6" Grid.Column="3" Text="Banque / RIB"/>
                        <TextBox Grid.Row="6" Grid.Column="4" Text="{Binding Bank}" ToolTip="Imprimé dans les conditions de l'offre (ex. : RAWBANK — compte n° …)."/>
                    </Grid>
                    <GroupBox Header="Logo (PNG ou JPG)" Margin="0,12,0,0" Padding="8">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="180" Height="90" Background="#FFFFFFFF" CornerRadius="4" Margin="0,0,12,0" Padding="6">
                                <Image Source="{Binding LogoPreview, TargetNullValue={x:Null}}" Stretch="Uniform"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding LogoLabel}" Foreground="#FF8AA4C8" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Choisir…" Command="{Binding ChooseLogoCommand}" Margin="0,0,4,0"/>
                                    <Button Content="Retirer" Command="{Binding ClearLogoCommand}"/>
                                </StackPanel>
                                <TextBlock Foreground="#FF8AA4C8" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"
                                           Text="Conseil : PNG à fond transparent, au moins 600 pixels de large. Le fond blanc de l'aperçu montre le rendu sur le PDF classique."/>
                            </StackPanel>
                        </DockPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="GroupHeader" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <Border BorderThickness="4,0,0,0" BorderBrush="{Binding Name, Converter={StaticResource LotColor}}" Margin="0,2,0,0">
                            <Expander IsExpanded="True" BorderThickness="0" Background="#FF13233D">
                                <Expander.Header>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{Binding Name, Converter={StaticResource LotColor}}" Margin="2"/>
                                </Expander.Header>
                                <ItemsPresenter/>
                            </Expander>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Zone cliquable du tableau de bord interactif : transparente, halo cyan au survol. -->
        <Style x:Key="Hit" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#FFE6F1FF"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2200E5FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6600E5FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4400E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Petit bouton rond "voir dans Revit". -->
        <Style x:Key="Pick" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Content" Value="⊙"/>
            <Setter Property="ToolTip" Value="Sélectionner et zoomer ces éléments dans Revit"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="#FF13233D" BorderBrush="#FF21E6A1" BorderThickness="1">
                            <TextBlock Text="⊙" Foreground="#FF21E6A1" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1F6B55"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="8">
        <!-- Portee et actions -->
        <Border DockPanel.Dock="Top" Background="#FF0F1A2E" BorderBrush="#FF1E3A5F" BorderThickness="1" Padding="8" Margin="0,0,0,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="Portée :" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                    <ComboBox Width="160" ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding SelectedScope}" DisplayMemberPath="Label" VerticalAlignment="Center"/>
                    <Expander Header="Niveaux" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="Aucun niveau coché = tous les niveaux.">
                        <Border Background="#FF0F1A2E" BorderBrush="#FF1E3A5F" BorderThickness="1" Padding="4" MaxHeight="220">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Levels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Expander>
                    <Button Content="Analyser" Command="{Binding AnalyzeCommand}" Margin="16,0,4,0" FontWeight="SemiBold"
                            Tag="primary"/>
                    <Button Content="Aperçu…" Command="{Binding PreviewCommand}" Tag="violet"
                            ToolTip="Voir le PDF page par page et le classeur Excel feuille par feuille AVANT d'écrire les fichiers."/>
                    <Button Content="Exporter Excel / PDF" Command="{Binding ExportCommand}" Tag="green"
                            ToolTip="Classeur Excel (page de garde, BOQ à formules vivantes, récapitulatif, détail du métré, audit, hypothèses), PDF prêt à signer, et CSV bruts."/>
                    <Button Content="Écrire les codes dans le modèle" Command="{Binding WriteParametersCommand}" Tag="orange"
                            ToolTip="Écrit DanCI_BOQ_Code et DanCI_BOQ_Lot sur les éléments métrés du modèle hôte. Seule action qui MODIFIE le modèle : confirmation demandée, une seule annulation (Ctrl+Z)."/>
                </StackPanel>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Foreground="#FF8AA4C8" Margin="12,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- Phase, demolitions, liens -->
        <Border DockPanel.Dock="Top" Background="#FF0F1A2E" BorderBrush="#FF1E3A5F" BorderThickness="1" Padding="8,4" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Phase métrée :" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                <ComboBox Width="220" ItemsSource="{Binding Phases}" SelectedItem="{Binding SelectedPhase}" VerticalAlignment="Center"
                          ToolTip="Seuls les éléments CRÉÉS dans cette phase et non démolis sont comptés (les existants sont exclus)."/>
                <CheckBox Content="Démolitions de la phase (lot séparé)" IsChecked="{Binding IncludeDemolition}" VerticalAlignment="Center" Margin="12,0,0,0"
                          ToolTip="Compte aussi les éléments démolis dans la phase, dans le lot DEM."/>
                <Expander Header="Liens RVT" Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="Liens chargés à inclure au métré (chaque instance est comptée).">
                    <Border Background="#FF0F1A2E" BorderBrush="#FF1E3A5F" BorderThickness="1" Padding="4" MaxHeight="200">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Links}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Expander>
                <TextBlock Text="{Binding ProjectFilePath, StringFormat=Projet : {0}}" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="#FF8AA4C8" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
            </StackPanel>
        </Border>

        <!-- Bibliotheque de prix du projet -->
        <Border DockPanel.Dock="Top" Background="#FF0F1A2E" BorderBrush="#FF1E3A5F" BorderThickness="1" Padding="8,4" Margin="0,0,0,6">
            <WrapPanel>
                <TextBlock Text="Prix :" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding PriceLibraryLabel}" VerticalAlignment="Center" MinWidth="200" TextTrimming="CharacterEllipsis" MaxWidth="360"
                           ToolTip="{Binding PriceLibraryPath}"/>
                <Button Content="Choisir…" Command="{Binding ChoosePriceLibraryCommand}"
                        ToolTip="Bibliothèque de prix du projet (par client, par ville) : fichier .json, ou classeur .xlsx à importer."/>
                <Button Content="Installation" Command="{Binding ResetPriceLibraryCommand}" ToolTip="Revenir à la bibliothèque de l'installation."/>
                <Button Content="Saisir les prix…" Command="{Binding ShowSettingsCommand}" Tag="amber"
                        ToolTip="Ouvre l'onglet « Paramètres du projet » : prix unitaires, TVA, majorations, identité, page de garde."/>
                <Button Content="Modèle Excel des prix…" Command="{Binding PriceTemplateCommand}"
                        ToolTip="Exporte tous les articles (PU vides s'il n'y a pas de prix) dans un classeur à remplir, puis à réimporter avec « Choisir… »."/>
                <TextBlock Text="Vue 3D colorée :" VerticalAlignment="Center" Margin="20,0,4,0" FontWeight="SemiBold"/>
                <Button Content="Par lot" Command="{Binding ColorizeCommand}" CommandParameter="lot" Tag="orange" MinWidth="70"
                        ToolTip="Crée ou met à jour la vue 3D « DanCI — BOQ par lot » : chaque élément métré prend la couleur de son lot, le reste est estompé. Modifie le modèle (une vue) : confirmation demandée, annulable."/>
                <Button Content="Par statut" Command="{Binding ColorizeCommand}" CommandParameter="statut" Tag="orange" MinWidth="70"
                        ToolTip="Mesuré vert, estimé ambre, forfait violet, manquant rouge : voir dans la maquette ce qui reste à vérifier."/>
                <Button Content="Par prix" Command="{Binding ColorizeCommand}" CommandParameter="prix" Tag="orange" MinWidth="70"
                        ToolTip="Prix renseigné vert, prix manquant rouge."/>
            </WrapPanel>
        </Border>

        <!-- Pied de devis -->
        <Border DockPanel.Dock="Bottom" Background="#FF0F1A2E" BorderBrush="#FF1E3A5F" BorderThickness="1" Padding="8" Margin="0,6,0,0">
            <StackPanel>
                <TextBlock Text="{Binding IncompleteText}" Foreground="#FFFF4D6D" FontWeight="SemiBold"
                           Visibility="{Binding IsIncomplete, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4"/>
                <WrapPanel>
                    <TextBlock Margin="0,0,24,0"><Run Text="Total travaux HT : " Foreground="#FF8AA4C8"/><Run Text="{Binding WorksTotal, Mode=OneWay}" FontWeight="SemiBold" Foreground="#FF4DA3FF"/></TextBlock>
                    <TextBlock Text="{Binding Markups}" Margin="0,0,24,0" Foreground="#FFB388FF"/>
                    <TextBlock Margin="0,0,24,0"><Run Text="Total HT : " Foreground="#FF8AA4C8"/><Run Text="{Binding TotalExcludingVat, Mode=OneWay}" FontWeight="SemiBold" Foreground="#FFFFFFFF"/></TextBlock>
                    <TextBlock Text="{Binding Vat}" Margin="0,0,24,0" Foreground="#FFFFC233"/>
                    <TextBlock Margin="0,0,8,0" Foreground="#FF21E6A1" FontSize="15">
                        <Run Text="Total TTC : "/><Run Text="{Binding TotalIncludingVat, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock Text="{Binding SecondaryTotal}" VerticalAlignment="Center"/>
                </WrapPanel>
                <TextBlock Text="{Binding AmountWords}" Foreground="#FF21E6A1" FontStyle="Italic" Margin="0,2,0,0" TextWrapping="Wrap" Style="{StaticResource Optional}"/>
                <TextBlock Text="{Binding ReliabilityText}" Foreground="{StaticResource DanciOrange}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding FooterText}" Foreground="#FF8AA4C8" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <TabControl SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="Tableau de bord" Tag="#FF00E5FF">
                <DockPanel Background="#FF070D1A">
                <!-- Barre de commande : bascule tableau interactif / planche du PDF -->
                <Border DockPanel.Dock="Top" Background="#FF0B1426" BorderBrush="#FF1E3A5F" BorderThickness="0,0,0,1" Padding="12,6">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{Binding BoardToggleLabel}" Command="{Binding ToggleBoardCommand}" Tag="violet"
                                ToolTip="Basculer entre le tableau de bord interactif et la planche dessinée (identique au PDF / Excel)."/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#FF21E6A1" Margin="0,0,8,0">
                                <Ellipse.Effect><DropShadowEffect Color="#FF21E6A1" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:1.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="EN DIRECT — dernière analyse" Foreground="#FF21E6A1" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="   ·   Cliquez sur une tuile, un lot, un voyant ou un article pour l'ouvrir ; ⊙ = voir dans Revit." Foreground="#FF8AA4C8" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Grid>
                <!-- Planche dessinee (meme rendu que le PDF et Excel), sur demande. -->
                <Border Background="#FF0E1730" Visibility="{Binding ShowBoardView, Converter={StaticResource BoolToVis}}">
                    <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="6">
                        <Image Source="{Binding DashboardImage}" Width="1600" Height="1000" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Viewbox>
                </Border>
                <!-- Tableau de bord interactif (vue par defaut) -->
                <Border Padding="14" Visibility="{Binding ShowInteractiveView, Converter={StaticResource BoolToVis}}">
                    <Border.Background>
                        <RadialGradientBrush Center="0.15,0" GradientOrigin="0.15,0" RadiusX="1.1" RadiusY="0.9">
                            <GradientStop Color="#FF0F2140" Offset="0"/>
                            <GradientStop Color="#FF070D1A" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel DataContext="{Binding Dashboard}">
                            <DockPanel Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <TextBlock Text="NOTE DE SANTÉ" Foreground="#FF8AA4C8" FontSize="10" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding ScoreText}" Foreground="{Binding ScoreColor}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right">
                                        <TextBlock.Effect><DropShadowEffect Color="#FF00E5FF" BlurRadius="14" ShadowDepth="0" Opacity="0.6"/></TextBlock.Effect>
                                    </TextBlock>
                                    <Border Height="4" Width="180" Background="#FF1E3A5F" HorizontalAlignment="Right">
                                        <Border Height="4" Width="{Binding ScoreAngleWidth}" Background="{Binding ScoreColor}" HorizontalAlignment="Left"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="TABLEAU DE BORD DE PILOTAGE" Foreground="#FF00E5FF" FontSize="20" FontWeight="Bold">
                                        <TextBlock.Effect><DropShadowEffect Color="#FF00E5FF" BlurRadius="16" ShadowDepth="0" Opacity="0.7"/></TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Title}" Foreground="#FF8AA4C8" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding Tiles}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Hit}" Margin="0,0,8,8" Width="204"
                                                Command="{Binding DataContext.DashboardNavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                ToolTip="{Binding Hint, TargetNullValue='Cliquer pour ouvrir le détail'}">
                                        <Border Padding="10" Background="#FF0F1A2E" BorderBrush="{Binding Accent}" BorderThickness="0,3,0,0" CornerRadius="6">
                                            <Border.Effect><DropShadowEffect Color="{Binding Accent}" BlurRadius="12" ShadowDepth="0" Opacity="0.25"/></Border.Effect>
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="›" Foreground="{Binding Accent}" FontSize="14" Margin="0,-4,0,0"/>
                                                    <TextBlock Text="{Binding Label}" Foreground="#FF8AA4C8" FontSize="10"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Value}" Foreground="{Binding Color}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <Border Height="4" Width="180" HorizontalAlignment="Left" Background="#FF1E3A5F" Margin="0,4,0,2"
                                                        Visibility="{Binding HasGauge, Converter={StaticResource BoolToVis}}">
                                                    <Border Height="4" Width="{Binding GaugeWidth}" HorizontalAlignment="Left" Background="{Binding Color}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Sub}" Foreground="#FF8AA4C8" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Anneau par lot · origine des montants · articles sans prix -->
                            <Grid Margin="0,6,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#FF0F1A2E" BorderBrush="#FF1E3A5F" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="ANNEAU DES LOTS" Foreground="#FF00E5FF" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <Grid Width="170" Height="170" HorizontalAlignment="Center">
                                            <Ellipse Stroke="#FF1E3A5F" StrokeThickness="28" Margin="2"/>
                                            <ItemsControl ItemsSource="{Binding Lots}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Cursor="Hand" ToolTip="{Binding Tooltip}"
                                                                Command="{Binding DataContext.DashboardNavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Path x:Name="Seg" Data="{Binding Arc, Converter={StaticResource PathGeo}}" Fill="{Binding Color}" Opacity="0.88">
                                                                        <Path.Effect><DropShadowEffect Color="#FF00E5FF" BlurRadius="6" ShadowDepth="0" Opacity="0.35"/></Path.Effect>
                                                                    </Path>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Seg" Property="Opacity" Value="1"/>
                                                                            <Setter TargetName="Seg" Property="Stroke" Value="#FFFFFFFF"/>
                                                                            <Setter TargetName="Seg" Property="StrokeThickness" Value="1.5"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <TextBlock Text="{Binding DonutCenterValue}" Foreground="#FFE6F1FF" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding DonutCenterLabel}" Foreground="#FF8AA4C8" FontSize="10" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="survol = montant · clic = BOQ du lot" Foreground="#FF8AA4C8" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#FF0F1A2E" BorderBrush="#FF1E3A5F" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="ORIGINE DES MONTANTS" Foreground="#FF21E6A1" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <TextBlock Text="D'où viennent les quantités qui font le devis ? Cliquez sur une part pour la vérifier." Foreground="#FF8AA4C8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <Border Background="#FF1E3A5F" CornerRadius="6" Height="22" Width="360" HorizontalAlignment="Left" ClipToBounds="True">
                                            <ItemsControl ItemsSource="{Binding Origins}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource Hit}" Width="{Binding Width}" ToolTip="{Binding Tooltip}"
                                                                Command="{Binding DataContext.DashboardNavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                            <Border Background="{Binding Color}" Height="22">
                                                                <TextBlock Text="{Binding Share}" Foreground="#FF070D1A" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Origins}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                                        <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Color}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Label}" Foreground="#FFE6F1FF" Width="70"/>
                                                        <TextBlock Text="{Binding Share}" Foreground="{Binding Color}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Aucun montant pour l'instant : saisissez les prix unitaires." Foreground="#FFFFC233" FontSize="11" TextWrapping="Wrap"
                                                   Visibility="{Binding ShowNoOrigins, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Background="#FF0F1A2E" BorderBrush="#FF1E3A5F" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock DockPanel.Dock="Right" Text="clic = saisir le prix" Foreground="#FF8AA4C8" FontSize="10" VerticalAlignment="Center"/>
                                            <TextBlock Text="PRIX À SAISIR" Foreground="#FFFF4D6D" FontWeight="Bold"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding MissingPricesHeader}" Foreground="#FF8AA4C8" FontSize="11" Style="{StaticResource Optional}" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding MissingPriceRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource Hit}" ToolTip="Ouvrir la saisie du prix de cet article"
                                                            Command="{Binding DataContext.DashboardNavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                        <Grid Margin="4,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="56"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Code}" Foreground="#FFFF4D6D" FontWeight="SemiBold"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Designation}" Foreground="#FFE6F1FF" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Quantity}" Foreground="#FF8AA4C8" Margin="8,0,0,0"/>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="✓ Tous les articles ont un prix." Foreground="#FF21E6A1"
                                                   Visibility="{Binding ShowAllPriced, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#FF0F1A2E" BorderBrush="#FF1E3A5F" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock DockPanel.Dock="Right" Text="clic = BOQ filtré sur le lot" Foreground="#FF8AA4C8" FontSize="10" VerticalAlignment="Center"/>
                                            <TextBlock Text="RÉPARTITION PAR LOT" Foreground="#FF00E5FF" FontWeight="Bold"/>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Lots}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource Pick}" VerticalAlignment="Center"
                                                                Command="{Binding DataContext.DashboardSelectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Button Style="{StaticResource Hit}" ToolTip="Ouvrir le BOQ filtré sur ce lot"
                                                                Command="{Binding DataContext.DashboardNavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                    <Grid Margin="4,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="270"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="56"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Code}" Foreground="{Binding Color}" FontWeight="Bold"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Designation}" Foreground="#FFE6F1FF" TextTrimming="CharacterEllipsis"/>
                                                        <Border Grid.Column="2" Height="8" Width="260" HorizontalAlignment="Left" Background="#FF1E3A5F" CornerRadius="4">
                                                            <Border Height="8" Width="{Binding BarWidth}" HorizontalAlignment="Left" Background="{Binding Color}" CornerRadius="4">
                                                                <Border.Effect><DropShadowEffect Color="#FF00E5FF" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
                                                            </Border>
                                                        </Border>
                                                        <TextBlock Grid.Column="3" Text="{Binding Amount}" Foreground="#FFE6F1FF" HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding Share}" Foreground="{Binding Color}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                        </Button>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="#FF0F1A2E" BorderBrush="#FF1E3A5F" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock DockPanel.Dock="Right" Text="clic = aller corriger" Foreground="#FF8AA4C8" FontSize="10" VerticalAlignment="Center"/>
                                            <TextBlock Text="VOYANTS" Foreground="#FFFFC233" FontWeight="Bold"/>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Signals}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource Hit}" ToolTip="Ouvrir l'endroit où corriger"
                                                            Command="{Binding DataContext.DashboardNavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                    <DockPanel Margin="4,3">
                                                        <Ellipse Width="9" Height="9" Fill="{Binding Color}" DockPanel.Dock="Left" Margin="0,4,8,0" VerticalAlignment="Top">
                                                            <Ellipse.Effect><DropShadowEffect Color="#FFFFFFFF" BlurRadius="8" ShadowDepth="0" Opacity="0.35"/></Ellipse.Effect>
                                                        </Ellipse>
                                                        <TextBlock DockPanel.Dock="Right" Text="›" Foreground="{Binding Color}" FontSize="14" VerticalAlignment="Center"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" Foreground="#FFE6F1FF" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Detail}" Foreground="#FF8AA4C8" FontSize="11" TextWrapping="Wrap" Style="{StaticResource Optional}"/>
                                                            <TextBlock Text="{Binding Action}" Foreground="{Binding Color}" FontSize="11" TextWrapping="Wrap" Style="{StaticResource Optional}"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#FF0F1A2E" BorderBrush="#FF1E3A5F" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock DockPanel.Dock="Right" Text="clic = détail du métré" Foreground="#FF8AA4C8" FontSize="10" VerticalAlignment="Center"/>
                                            <TextBlock Text="PARETO — LES ARTICLES QUI FONT LE DEVIS" Foreground="#FFFF8A00" FontWeight="Bold"/>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Pareto}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource Pick}" VerticalAlignment="Center"
                                                                Command="{Binding DataContext.DashboardSelectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Button Style="{StaticResource Hit}" ToolTip="Ouvrir l'article et son détail du métré"
                                                                Command="{Binding DataContext.DashboardNavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                    <Grid Margin="4,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="24"/>
                                                            <ColumnDefinition Width="56"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="130"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Rank}" Foreground="#FFFF8A00" FontWeight="Bold"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Code}" Foreground="#FF8AA4C8"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Designation}" Foreground="#FFE6F1FF" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Amount}" Foreground="#FFE6F1FF" HorizontalAlignment="Right"/>
                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Border Height="6" Width="{Binding CumulativeWidth}" Background="#FFFF8A00" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,6,0" MaxWidth="80"/>
                                                            <TextBlock Text="{Binding Cumulative}" Foreground="#FFFF8A00"/>
                                                        </StackPanel>
                                                    </Grid>
                                                        </Button>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding ParetoEmpty}" Foreground="#FFFFC233" TextWrapping="Wrap" Style="{StaticResource Optional}"/>
                                        <TextBlock Text="Barre orange : part cumulée du total des travaux." Foreground="#FF8AA4C8" FontSize="10" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="#FF0F1A2E" BorderBrush="#FF1E3A5F" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock DockPanel.Dock="Right" Text="⊙ = voir dans Revit" Foreground="#FF8AA4C8" FontSize="10" VerticalAlignment="Center"/>
                                            <TextBlock Text="QUANTITÉS CLÉS (NETTES)" Foreground="#FF21E6A1" FontWeight="Bold"/>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding KeyQuantities}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" Foreground="#FFE6F1FF"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#FFE6F1FF" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Measured}" Foreground="{Binding MeasuredColor}" FontSize="11" HorizontalAlignment="Right"/>
                                                        <Button Grid.Column="3" Style="{StaticResource Pick}"
                                                                Command="{Binding DataContext.DashboardSelectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Foreground="#FF8AA4C8" FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="Indicateurs calculés uniquement à partir du BOQ, de l'audit et du métré de la dernière analyse ; ils se mettent à jour à chaque analyse et à chaque enregistrement des prix. La note de santé (prix 50, fiabilité 30, audit 20) aide au pilotage ; elle ne remplace pas la vérification du métreur. La planche dessinée (bouton en haut à droite) est celle du PDF et du classeur exportés."/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                </Grid>
                </DockPanel>
            </TabItem>

            <!-- BOQ -->
            <TabItem Header="BOQ" Tag="#FF21E6A1">
                <DockPanel>
                <Border DockPanel.Dock="Top" Background="#FF13233D" BorderBrush="#FF00E5FF" BorderThickness="3,0,0,0" Padding="10,4" Margin="0,0,0,4"
                        Visibility="{Binding HasLotFilter, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="✕ Afficher tous les lots" Command="{Binding ClearLotFilterCommand}"/>
                        <TextBlock Text="{Binding LotFilterText}" Foreground="#FF00E5FF" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="LinesGrid" ItemsSource="{Binding LinesView}" SelectedItem="{Binding SelectedLine}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              CanUserAddRows="False" SelectionMode="Single" EnableRowVirtualization="True"
                              ToolTip="Double-clic : sélectionner et zoomer les éléments dans Revit.">
                        <DataGrid.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding SelectLineCommand}" CommandParameter="{Binding SelectedItem, ElementName=LinesGrid}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource GroupHeader}"/>
                        </DataGrid.GroupStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUnclassified}" Value="True">
                                        <Setter Property="Background" Value="#FF3A2A12"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N°" Binding="{Binding Code}" Width="80"/>
                            <DataGridTextColumn Header="Désignation" Binding="{Binding Designation}" Width="*"/>
                            <DataGridTextColumn Header="Unité" Binding="{Binding Unit}" Width="50"/>
                            <DataGridTextColumn Header="Qté nette" Binding="{Binding NetQuantity, StringFormat=N3}" Width="90" ElementStyle="{StaticResource Number}"/>
                            <DataGridTextColumn Header="Coef." Binding="{Binding CoefficientFactor, StringFormat=0.####}" Width="60" ElementStyle="{StaticResource Number}"/>
                            <DataGridTextColumn Header="Quantité" Binding="{Binding Quantity, StringFormat=N2}" Width="90" ElementStyle="{StaticResource QuantityStrong}"/>
                            <DataGridTextColumn Header="PU" Binding="{Binding UnitPrice, StringFormat=N2}" Width="90" ElementStyle="{StaticResource Price}"/>
                            <DataGridTextColumn Header="Montant" Binding="{Binding Amount, StringFormat=N2}" Width="110" ElementStyle="{StaticResource Amount}"/>
                            <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="110" ElementStyle="{StaticResource StatusText}"/>
                            <DataGridTextColumn Header="Élém." Binding="{Binding ElementCount}" Width="50" ElementStyle="{StaticResource Number}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#FF1E3A5F"/>
                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedLineInfo}" TextWrapping="Wrap" Margin="2,4" Foreground="#FF8AA4C8"/>
                        <DataGrid x:Name="DetailGrid" ItemsSource="{Binding Contributions}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single"
                                  ToolTip="Détail du métré. Double-clic : sélectionner et zoomer l'élément dans Revit.">
                            <DataGrid.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding SelectContributionCommand}" CommandParameter="{Binding SelectedItem, ElementName=DetailGrid}"/>
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ElementId" Binding="{Binding ElementId}" Width="80"/>
                                <DataGridTextColumn Header="Lien" Binding="{Binding Source}" Width="90"/>
                                <DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Width="120"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="160"/>
                                <DataGridTextColumn Header="Matériau" Binding="{Binding Material}" Width="140"/>
                                <DataGridTextColumn Header="Niveau" Binding="{Binding Level}" Width="90"/>
                                <DataGridTextColumn Header="Quantité" Binding="{Binding Value, StringFormat=N3}" Width="80" ElementStyle="{StaticResource Number}"/>
                                <DataGridTextColumn Header="Unité" Binding="{Binding Unit}" Width="45"/>
                                <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="100" ElementStyle="{StaticResource StatusText}"/>
                                <DataGridTextColumn Header="Règle" Binding="{Binding RuleId}" Width="100"/>
                                <DataGridTextColumn Header="Méthode / hypothèse" Binding="{Binding Method}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
                </DockPanel>
            </TabItem>

            <!-- Audit -->
            <TabItem Header="{Binding AuditHeader}" Tag="#FFFFC233">
                <DataGrid x:Name="AuditGrid" ItemsSource="{Binding FindingsView}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single">
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding SelectFindingCommand}" CommandParameter="{Binding SelectedItem, ElementName=AuditGrid}"/>
                    </DataGrid.InputBindings>
                    <DataGrid.GroupStyle>
                        <GroupStyle ContainerStyle="{StaticResource GroupHeader}"/>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Sélectionner" MinWidth="80" Padding="4,1" Margin="2"
                                            Command="{Binding DataContext.SelectFindingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" IsEnabled="{Binding CanSelect}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Gravité" Binding="{Binding Severity}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding SeverityColor}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="170"/>
                        <DataGridTextColumn Header="Élém." Binding="{Binding ElementCount}" Width="50" ElementStyle="{StaticResource Number}"/>
                        <DataGridTextColumn Header="Constat" Binding="{Binding Message}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Forfaits -->
            <TabItem Header="Forfaits" Tag="#FFB388FF">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4">
                        <Button Content="Ajouter" Command="{Binding AddManualCommand}"/>
                        <Button Content="Supprimer" Command="{Binding RemoveManualCommand}" CommandParameter="{Binding SelectedItem, ElementName=ManualGrid}"/>
                        <Button Content="Enregistrer et recalculer" Command="{Binding SaveManualCommand}" FontWeight="SemiBold"
                                ToolTip="Enregistre les forfaits dans le fichier projet .danciboq.json et recalcule le BOQ sans réanalyser la maquette."/>
                        <TextBlock Text="Lignes non métrables (installation de chantier, études, essais…), conservées dans le fichier projet." VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#FF8AA4C8"/>
                    </StackPanel>
                    <DataGrid x:Name="ManualGrid" ItemsSource="{Binding ManualLines}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Lot" Binding="{Binding Lot, UpdateSourceTrigger=LostFocus}" Width="50"/>
                            <DataGridTextColumn Header="Code (facultatif)" Binding="{Binding Code}" Width="100"/>
                            <DataGridTextColumn Header="Désignation" Binding="{Binding Designation}" Width="*"/>
                            <DataGridComboBoxColumn Header="Unité" SelectedItemBinding="{Binding Unit}" Width="60">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox"><Setter Property="ItemsSource" Value="{Binding DataContext.UnitChoices, RelativeSource={RelativeSource AncestorType=Window}}"/></Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox"><Setter Property="ItemsSource" Value="{Binding DataContext.UnitChoices, RelativeSource={RelativeSource AncestorType=Window}}"/></Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                            <DataGridTextColumn Header="Quantité" Binding="{Binding Quantity}" Width="80"/>
                            <DataGridTextColumn Header="PU" Binding="{Binding UnitPrice, TargetNullValue=''}" Width="90"/>
                            <DataGridComboBoxColumn Header="Devise" SelectedItemBinding="{Binding Currency}" Width="60">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox"><Setter Property="ItemsSource" Value="{Binding DataContext.CurrencyChoices, RelativeSource={RelativeSource AncestorType=Window}}"/></Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox"><Setter Property="ItemsSource" Value="{Binding DataContext.CurrencyChoices, RelativeSource={RelativeSource AncestorType=Window}}"/></Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                            <DataGridTextColumn Header="Justification" Binding="{Binding Justification}" Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Validation (etape 8) -->
            <TabItem Header="Validation" Tag="#FF4DA3FF">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource DanciBlue}" Text="Validation du métré (protocole VALIDATION.md)"/>
                        <TextBlock Margin="0,4,0,12" TextWrapping="Wrap"><Run Text="Empreinte du métré de la dernière analyse : "/><Run Text="{Binding Fingerprint, Mode=OneWay}" FontWeight="Bold"/><Run Text=" — deux analyses du même modèle (Revit 2026 et 2027) doivent donner la même."/></TextBlock>

                        <TextBlock FontWeight="SemiBold" Text="1. Comparer au métré manuel (cible : écart inférieur à 2 % sur le béton et l'acier)"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,6" Foreground="#FF8AA4C8"
                                   Text="Générez le gabarit, faites-le remplir à la main par le métreur (les quantités du modèle n'y figurent volontairement pas), puis comparez. Le rapport donne l'écart par élément, par article et par nature, et les pistes d'explication de chaque écart."/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Content="Générer le gabarit de métré manuel" Command="{Binding ValidationTemplateCommand}"/>
                            <Button Content="Comparer au gabarit rempli…" Command="{Binding CompareManualCommand}" FontWeight="SemiBold"/>
                        </StackPanel>

                        <TextBlock FontWeight="SemiBold" Text="2. Reproductibilité entre versions de Revit"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,6" Foreground="#FF8AA4C8"
                                   Text="Analysez le même fichier dans Revit 2026 puis 2027 (même portée, même phase, même configuration), exportez, puis comparez les deux fichiers « …_metre_brut.csv ». Toute différence est listée quantité par quantité."/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Content="Comparer deux métrés bruts (CSV)…" Command="{Binding CompareRunsCommand}"/>
                        </StackPanel>

                        <TextBlock FontWeight="SemiBold" Text="3. Historique des révisions du devis (indice A, B, C…)" Foreground="#FFB388FF"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,6" Foreground="#FF8AA4C8"
                                   Text="Chaque export enregistre une révision : un instantané des lignes, des prix et des totaux, à côté du projet. Choisissez une révision, puis comparez-la à la dernière analyse. Vous obtenez un classeur avec la synthèse, les écarts par lot (avec un graphique) et les écarts par article (ajoutés, supprimés, modifiés ; cause : quantité ou prix)."/>
                        <DataGrid ItemsSource="{Binding Revisions}" SelectedItem="{Binding SelectedRevision}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" MaxHeight="200" MinHeight="70">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Révision" Binding="{Binding Label}" Width="*"/>
                                <DataGridTextColumn Header="Version" Binding="{Binding ApplicationVersion}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Comparer la dernière analyse à cette révision" Command="{Binding CompareRevisionCommand}" Tag="violet"/>
                            <Button Content="Enregistrer une révision maintenant" Command="{Binding FreezeRevisionCommand}"
                                    ToolTip="Fige l'état actuel du devis (sans exporter). Pensez à changer l'indice dans Paramètres du projet > Identité."/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Exclus -->
            <TabItem Header="{Binding ExcludedHeader}" Tag="#FFFF5CA8">
                <DataGrid x:Name="ExcludedGrid" ItemsSource="{Binding Excluded}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single"
                          ToolTip="Quantités écartées du métré, avec leur motif. Double-clic : sélectionner dans Revit.">
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding SelectExcludedCommand}" CommandParameter="{Binding SelectedItem, ElementName=ExcludedGrid}"/>
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ElementId" Binding="{Binding ElementId}" Width="90"/>
                        <DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Width="140"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="180"/>
                        <DataGridTextColumn Header="Nature" Binding="{Binding Kind}" Width="110"/>
                        <DataGridTextColumn Header="Quantité" Binding="{Binding Value}" Width="100"/>
                        <DataGridTextColumn Header="Motif" Binding="{Binding Reason}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Parametres du projet -->
            <TabItem Header="Paramètres du projet" Tag="#FFFF8A00">
                <DockPanel DataContext="{Binding Settings}">
                    <Border DockPanel.Dock="Bottom" Background="#FF0F1A2E" BorderBrush="#FF1E3A5F" BorderThickness="1" Padding="8" Margin="0,6,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Enregistrer les paramètres du projet" FontWeight="SemiBold"
                                    Tag="primary" Padding="16,6"
                                    Command="{Binding DataContext.SaveSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="Écrit le fichier projet .danciboq.json (et la bibliothèque de prix du projet si des prix ont changé), puis recalcule le BOQ. Le modèle Revit n'est PAS modifié."/>
                            <TextBlock TextWrapping="Wrap" Foreground="#FF8AA4C8" VerticalAlignment="Center"
                                       Text="Tant que vous n'avez pas cliqué sur « Enregistrer », le BOQ et les exports gardent les paramètres précédents. Un champ d'identité vide reprend la valeur des Informations sur le projet de Revit."/>
                        </DockPanel>
                    </Border>
                    <TabControl TabStripPlacement="Left" SelectedIndex="{Binding DataContext.SettingsSubTab, RelativeSource={RelativeSource AncestorType=Window}}">
                        <TabItem Header="Identité du projet">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="10">
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock" x:Key="Lbl">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="0,3,8,3"/>
                                        </Style>
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*" MaxWidth="420"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*" MaxWidth="420"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="0" Text="Nom du projet"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Revit.Name}"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="1" Text="Objet du devis"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Purpose}" ToolTip="Ex. : Construction d'un immeuble R+3 à usage de bureaux"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="2" Text="N° de projet"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Number}" ToolTip="{Binding Revit.Number}"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="3" Text="Référence du devis"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding QuoteReference}"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="4" Text="Indice de révision"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Revision}" ToolTip="A, B, C…"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="5" Text="Date du devis"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding IssueDate}" ToolTip="{Binding Revit.IssueDate}"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="6" Text="Statut"/>
                                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Status}" ToolTip="Ex. : APD, DCE, Offre"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="7" Text="Surface de référence (m²)"/>
                                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding ReferenceArea}" ToolTip="Pour le coût TTC au m² du tableau de bord."/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="8" Text="Nature de la surface"/>
                                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding ReferenceAreaLabel}" ToolTip="Ex. : surface de plancher, SHON"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="9" Text="Notes (pied de devis)"/>
                                    <TextBox Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44"/>

                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="0" Grid.Column="3" Text="Maître d'ouvrage" ToolTip="Remplacé par le nom de la fiche Client s'il est saisi."/>
                                    <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding Client}" ToolTip="{Binding Revit.Client}"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="1" Grid.Column="3" Text="Maître d'œuvre / architecte"/>
                                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Architect}"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="2" Grid.Column="3" Text="Bureau d'études"/>
                                    <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding Engineer}"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="3" Grid.Column="3" Text="Entreprise"/>
                                    <TextBox Grid.Row="3" Grid.Column="4" Text="{Binding Contractor}"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="4" Grid.Column="3" Text="Lieu"/>
                                    <TextBox Grid.Row="4" Grid.Column="4" Text="{Binding Location}" ToolTip="{Binding Revit.Location}"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="5" Grid.Column="3" Text="Établi par"/>
                                    <TextBox Grid.Row="5" Grid.Column="4" Text="{Binding Author}" ToolTip="{Binding Revit.Author}"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="6" Grid.Column="3" Text="Vérifié par"/>
                                    <TextBox Grid.Row="6" Grid.Column="4" Text="{Binding CheckedBy}"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="7" Grid.Column="3" Text="Validité de l'offre (jours)"/>
                                    <TextBox Grid.Row="7" Grid.Column="4" Text="{Binding ValidityDays}"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="8" Grid.Column="3" Text="Délai d'exécution"/>
                                    <TextBox Grid.Row="8" Grid.Column="4" Text="{Binding ExecutionTime}"/>
                                    <TextBlock Style="{StaticResource Lbl}" Grid.Row="10" Text="Conditions de paiement"/>
                                    <TextBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding PaymentTerms}"/>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Modèles de devis">
                            <DockPanel Margin="10">
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="Modèles de devis réutilisables" FontSize="15" FontWeight="SemiBold" Foreground="#FFFF8A00"/>
                                    <TextBlock Foreground="#FF8AA4C8" TextWrapping="Wrap" Margin="0,2,0,10"
                                               Text="Un modèle reprend la saisie en cours (TVA et majorations, prix, page de garde, conditions, client) pour l'appliquer à un autre projet en un clic. Modèles communs à tous les projets : %AppData%\DanCI\BOQ\modeles. Appliquer un modèle remplit la saisie : rien n'est enregistré avant « Enregistrer les paramètres du projet »."/>
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding TemplateStatus}" Foreground="#FF21E6A1" TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource Optional}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="380"/>
                                    </Grid.ColumnDefinitions>
                                    <GroupBox Header="Modèles enregistrés" Padding="6">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                                <Button Content="Appliquer au projet" Command="{Binding ApplyTemplateCommand}" Tag="green" Margin="0,0,4,0"/>
                                                <Button Content="Supprimer" Command="{Binding DeleteTemplateCommand}" Tag="orange"/>
                                                <Button Content="Actualiser" Command="{Binding RefreshTemplatesCommand}"/>
                                            </StackPanel>
                                            <DataGrid ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" AutoGenerateColumns="False" IsReadOnly="True"
                                                      HeadersVisibility="Column" MinHeight="160">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="180"/>
                                                    <DataGridTextColumn Header="Contenu" Binding="{Binding Contents}" Width="220"/>
                                                    <DataGridTextColumn Header="Enregistré le" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="120"/>
                                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </GroupBox>
                                    <GroupBox Grid.Column="2" Header="Enregistrer la saisie comme modèle" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="Nom du modèle"/>
                                            <TextBox Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ex. : Client ABC — bureaux Kinshasa"/>
                                            <TextBlock Text="Description" Margin="0,6,0,0"/>
                                            <TextBox Text="{Binding TemplateDescription}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40"/>
                                            <TextBlock Text="Inclure :" Margin="0,8,0,2" FontWeight="SemiBold"/>
                                            <CheckBox Content="TVA, devise, majorations, taux" IsChecked="{Binding IncludeEstimate}" Margin="0,2"/>
                                            <CheckBox Content="Prix unitaires saisis" IsChecked="{Binding IncludePrices}" Margin="0,2"/>
                                            <CheckBox Content="Page de garde (style, sous-titre, logo)" IsChecked="{Binding IncludeCover}" Margin="0,2"/>
                                            <CheckBox Content="Conditions (validité, délai, paiement, notes)" IsChecked="{Binding IncludeConditions}" Margin="0,2"/>
                                            <CheckBox Content="Fiche client" IsChecked="{Binding IncludeClient}" Margin="0,2"/>
                                            <Button Content="Enregistrer comme modèle" Command="{Binding SaveTemplateCommand}" Tag="primary" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                            <TextBlock Foreground="#FF8AA4C8" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"
                                                       Text="Même nom = modèle remplacé. L'image du projet et une page de garde importée ne sont pas reprises (propres à un projet)."/>
                                        </StackPanel>
                                    </GroupBox>
                                </Grid>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="Client">
                            <ContentControl Content="{Binding ClientParty}" ContentTemplate="{StaticResource PartyForm}"/>
                        </TabItem>

                        <TabItem Header="Notre entreprise">
                            <ContentControl Content="{Binding Company}" ContentTemplate="{StaticResource PartyForm}"/>
                        </TabItem>

                        <TabItem Header="Devis : TVA, devise">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10" MaxWidth="900" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding EstimateOrigin}" Foreground="#FF00E5FF" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <TextBlock Text="Devise du devis :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox Width="90" ItemsSource="{Binding Currencies}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Currency}"/>
                                        <TextBlock Text="TVA (%) :" VerticalAlignment="Center" Margin="24,0,6,0"/>
                                        <TextBox Width="70" Text="{Binding VatPercent}" ToolTip="RDC : 16"/>
                                    </WrapPanel>
                                    <GroupBox Header="Majorations de pied de devis (appliquées dans cet ordre)" Margin="0,12,0,0" Padding="6">
                                        <StackPanel>
                                            <DataGrid ItemsSource="{Binding Markups}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                                                      MinHeight="90" x:Name="MarkupGrid">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="110"/>
                                                    <DataGridTextColumn Header="Désignation" Binding="{Binding Designation}" Width="*"/>
                                                    <DataGridTextColumn Header="%" Binding="{Binding Percent}" Width="70"/>
                                                    <DataGridComboBoxColumn Header="Base" Width="160" SelectedValueBinding="{Binding Base}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                                                            ItemsSource="{x:Static vm:SettingsViewModel.MarkupBaseChoices}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Button Content="Ajouter" Command="{Binding AddMarkupCommand}"/>
                                                <Button Content="Supprimer" Command="{Binding RemoveMarkupCommand}" CommandParameter="{Binding SelectedItem, ElementName=MarkupGrid}"/>
                                                <TextBlock Text="« sur les travaux » : % du total des lots. « en cascade » : % du total cumulé (travaux + majorations précédentes)."
                                                           Foreground="#FF8AA4C8" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="520"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="Devise secondaire et taux de change (saisi à la main, daté)" Margin="0,12,0,0" Padding="6">
                                        <WrapPanel>
                                            <TextBlock Text="Afficher le TTC aussi en :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox Width="100" ItemsSource="{Binding SecondaryCurrencies}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding SecondaryCurrency}"/>
                                            <TextBlock Text="1 USD =" VerticalAlignment="Center" Margin="20,0,6,0"/>
                                            <TextBox Width="90" Text="{Binding Rate}"/>
                                            <TextBlock Text="CDF   du" VerticalAlignment="Center" Margin="6,0,6,0"/>
                                            <DatePicker Width="130" SelectedDate="{Binding RateDate}"/>
                                            <TextBlock Text="Source :" VerticalAlignment="Center" Margin="16,0,6,0"/>
                                            <TextBox Width="220" Text="{Binding RateSource}" ToolTip="Ex. : taux BCC du jour"/>
                                        </WrapPanel>
                                    </GroupBox>
                                    <Button Content="Revenir aux réglages de l'installation" Command="{Binding ResetEstimateCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                    <TextBlock Foreground="#FF8AA4C8" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Text="Les décimales et la quantité valorisée (brute ou nette) restent celles de config\parametres_devis.json : elles valent pour tous les projets."/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Prix unitaires">
                            <DockPanel Margin="6">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding PriceLibraryInfo}" Foreground="#FF00E5FF" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Text="Rechercher :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Width="220" Text="{Binding PriceFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                        <CheckBox Content="Seulement les articles sans prix" IsChecked="{Binding OnlyMissing}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                        <TextBlock Text="{Binding PricesSummary}" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold"/>
                                    </WrapPanel>
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Bottom" Foreground="#FF8AA4C8" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="PU vide = pas de prix : la ligne reste signalée « sans prix ». La décomposition (matériaux + main-d'œuvre + matériel) est facultative ; si elle est saisie, sa somme doit égaler le PU. Les prix par type (portes, diamètres…) de la bibliothèque sont conservés tels quels. Aucun prix n'est proposé par l'extension."/>
                                <DataGrid ItemsSource="{Binding PricesView}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          HeadersVisibility="Column" FrozenColumnCount="2" EnableRowVirtualization="True" x:Name="PriceGrid">
                                    <DataGrid.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <Border BorderThickness="4,0,0,0" BorderBrush="{Binding Name, Converter={StaticResource LotColor}}" Margin="0,6,0,2" Padding="6,0,0,0">
                                                        <TextBlock Text="{Binding Name, StringFormat=LOT {0}}" FontWeight="SemiBold" Foreground="{Binding Name, Converter={StaticResource LotColor}}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </DataGrid.GroupStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" IsReadOnly="True" Width="70"/>
                                        <DataGridTextColumn Header="Désignation" Binding="{Binding Designation}" IsReadOnly="True" Width="*"/>
                                        <DataGridTextColumn Header="Unité" Binding="{Binding UnitSymbol}" IsReadOnly="True" Width="50"/>
                                        <DataGridTextColumn Header="PU" Binding="{Binding UnitPrice, UpdateSourceTrigger=LostFocus}" Width="90">
                                            <DataGridTextColumn.CellStyle>
                                                <Style TargetType="DataGridCell">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasNoPrice}" Value="True">
                                                            <Setter Property="Background" Value="#FF4A1F2A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.CellStyle>
                                        </DataGridTextColumn>
                                        <DataGridComboBoxColumn Header="Devise" SelectedItemBinding="{Binding Currency}" Width="64"
                                                                ItemsSource="{x:Static vm:SettingsViewModel.PriceCurrencies}"/>
                                        <DataGridTemplateColumn Header="Date du prix" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Date, StringFormat=dd/MM/yyyy}" Margin="2"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <DatePicker SelectedDate="{Binding Date, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="160"/>
                                        <DataGridTextColumn Header="Matériaux" Binding="{Binding Materials}" Width="76"/>
                                        <DataGridTextColumn Header="Main-d'œuvre" Binding="{Binding Labour}" Width="84"/>
                                        <DataGridTextColumn Header="Matériel" Binding="{Binding Equipment}" Width="70"/>
                                        <DataGridTextColumn Header="Prix par type" Binding="{Binding SpecificLabel}" IsReadOnly="True" Width="150"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="Réglages du métré">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10" MaxWidth="900" HorizontalAlignment="Left">
                                    <TextBlock Text="Réglages du métré (propres à ce projet)" FontSize="15" FontWeight="SemiBold" Foreground="#FFFF8A00"/>
                                    <TextBlock Foreground="#FF8AA4C8" TextWrapping="Wrap" Margin="0,2,0,10"
                                               Text="Ces réglages remplacent ceux de config\extraction.json pour ce projet seulement. Ils agissent à l'extraction : après « Enregistrer », relancez l'ANALYSE pour les appliquer."/>
                                    <GroupBox Header="Terrassements" Padding="8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <WrapPanel Margin="0,0,0,6">
                                                <TextBlock Text="Niveau du terrain naturel :" VerticalAlignment="Center" Width="200"/>
                                                <ComboBox Width="260" ItemsSource="{Binding GroundLevels}" SelectedItem="{Binding ExtGroundLevel}"
                                                          ToolTip="Sans ce niveau : pas de fouilles, ni pleine masse, ni remblai, ni évacuation des fouilles."/>
                                                <TextBlock Text="décalage (m) :" VerticalAlignment="Center" Margin="16,0,6,0"/>
                                                <TextBox Width="70" Text="{Binding ExtGroundOffset}" ToolTip="Ex. -0,30 si le terrain est 30 cm sous ce niveau."/>
                                            </WrapPanel>
                                            <WrapPanel Margin="0,0,0,6">
                                                <TextBlock Text="Coefficient de foisonnement :" VerticalAlignment="Center" Width="200"/>
                                                <TextBox Width="70" Text="{Binding ExtBulking}" ToolTip="1,10 à 1,40 selon le sol (étude géotechnique)."/>
                                            </WrapPanel>
                                            <WrapPanel Margin="0,0,0,6">
                                                <CheckBox Content="Décapage de terre végétale, épaisseur (m) :" IsChecked="{Binding ExtStripping}" VerticalAlignment="Center" Width="280"/>
                                                <TextBox Width="70" Text="{Binding ExtStrippingThickness}"/>
                                            </WrapPanel>
                                            <CheckBox Content="Fouille en pleine masse sous les sous-sols (sols sous le terrain naturel)" IsChecked="{Binding ExtBulk}"/>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="Dallages sur terre-plein" Padding="8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <WrapPanel Margin="0,0,0,6">
                                                <TextBlock Text="Épaisseur du hérisson (m) :" VerticalAlignment="Center" Width="200"/>
                                                <TextBox Width="70" Text="{Binding ExtHardcore}"/>
                                            </WrapPanel>
                                            <CheckBox Content="Considérer aussi les sols du niveau le plus bas comme dallages sur terre-plein (signalé « estimé »)" IsChecked="{Binding ExtSlabsLowest}"/>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="Ouvrages de second œuvre à métrer" Padding="8">
                                        <WrapPanel>
                                            <CheckBox Content="Garde-corps" IsChecked="{Binding ExtRailings}" Margin="0,2,20,2"/>
                                            <CheckBox Content="Gouttières et bandeaux" IsChecked="{Binding ExtGutters}" Margin="0,2,20,2"/>
                                            <CheckBox Content="Faux-plafonds" IsChecked="{Binding ExtCeilings}" Margin="0,2,20,2"/>
                                            <CheckBox Content="Murs-rideaux" IsChecked="{Binding ExtCurtainWalls}" Margin="0,2,20,2"/>
                                            <CheckBox Content="Plinthes" IsChecked="{Binding ExtSkirtings}" Margin="0,2,20,2"/>
                                        </WrapPanel>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Échéancier">
                            <DockPanel Margin="10">
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="Échéancier financier" FontSize="15" FontWeight="SemiBold" Foreground="#FFFF8A00"/>
                                    <TextBlock Foreground="#FF8AA4C8" TextWrapping="Wrap" Margin="0,2,0,8"
                                               Text="Le montant HT de chaque lot est réparti uniformément sur sa période ; chaque mois porte sa part des majorations et de la TVA. Le PDF reçoit une page Échéancier (planning des lots et besoin TTC par mois), et le classeur une feuille Échéancier, avec ses formules et un graphique."/>
                                    <CheckBox Content="Inclure l'échéancier dans les exports" IsChecked="{Binding UseSchedule}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <TextBlock Text="Durée totale (mois) :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Width="60" Text="{Binding ScheduleMonths, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Text="Démarrage :" VerticalAlignment="Center" Margin="20,0,6,0"/>
                                        <DatePicker Width="130" SelectedDate="{Binding ScheduleStart}" ToolTip="Facultatif : les mois s'affichent alors en clair (janv. 2027…)."/>
                                        <Button Content="Tous les lots sur toute la durée" Command="{Binding SpreadLotsCommand}" Margin="20,0,4,0"/>
                                        <Button Content="Proposer un enchaînement" Command="{Binding SequenceLotsCommand}" Tag="violet"
                                                ToolTip="Proposition de départ : lots enchaînés dans l'ordre du catalogue, avec chevauchement. À ajuster selon votre planning réel."/>
                                    </WrapPanel>
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding LotPeriods}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          HeadersVisibility="Column" Margin="0,8,0,0" IsEnabled="{Binding UseSchedule}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Lot" Binding="{Binding Lot}" IsReadOnly="True" Width="60"/>
                                        <DataGridTextColumn Header="Désignation" Binding="{Binding Designation}" IsReadOnly="True" Width="*"/>
                                        <DataGridTextColumn Header="Début (mois n°)" Binding="{Binding Start}" Width="110"/>
                                        <DataGridTextColumn Header="Durée (mois)" Binding="{Binding Duration}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="Page de garde">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10" MaxWidth="900" HorizontalAlignment="Left">
                                    <WrapPanel>
                                        <TextBlock Text="Style :" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                                        <ComboBox Width="320" ItemsSource="{Binding Themes}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Theme}"/>
                                    </WrapPanel>
                                    <TextBlock Text="Le style s'applique à la page de garde et au tableau de bord du PDF et du classeur. Les pages du BOQ restent sur fond blanc (impression, signature)."
                                               Foreground="#FF8AA4C8" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                    <WrapPanel Margin="0,0,0,8">
                                        <TextBlock Text="Sous-titre :" VerticalAlignment="Center" Margin="0,0,6,0" Width="150"/>
                                        <TextBox Width="460" Text="{Binding Subtitle}" ToolTip="Ex. : Dossier d'appel d'offres — Phase APD. Vide : l'objet du devis."/>
                                    </WrapPanel>
                                    <GroupBox Header="Image du projet (rendu, perspective, photo) — sur la page générée" Padding="6" Margin="0,0,0,8">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Retirer" Command="{Binding ClearImageCommand}" CommandParameter="image"/>
                                            <Button DockPanel.Dock="Right" Content="Choisir…" Command="{Binding ChooseProjectImageCommand}"/>
                                            <TextBlock Text="{Binding ProjectImage, TargetNullValue='(aucune)'}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </GroupBox>
                                    <GroupBox Header="Page de garde réalisée à part (PNG/JPG A4 portrait) — remplace la page générée" Padding="6" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Retirer" Command="{Binding ClearImageCommand}" CommandParameter="page"/>
                                                <Button DockPanel.Dock="Right" Content="Choisir…" Command="{Binding ChooseImportedPageCommand}"/>
                                                <TextBlock Text="{Binding ImportedPage, TargetNullValue='(aucune : page générée)'}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <TextBlock Foreground="#FF8AA4C8" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Text="Pour une page conçue dans un autre logiciel (Canva, Photoshop, InDesign…) : exportez-la en PNG ou JPG au format A4 portrait (au moins 1240 × 1754 pixels) et choisissez-la ici. Retirez-la pour revenir à la page générée."/>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="Logo du projet (facultatif ; sinon config\logo.png)" Padding="6">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Retirer" Command="{Binding ClearImageCommand}" CommandParameter="logo"/>
                                            <Button DockPanel.Dock="Right" Content="Choisir…" Command="{Binding ChooseLogoCommand}"/>
                                            <TextBlock Text="{Binding Logo, TargetNullValue='(logo de l&#x2019;installation)'}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </GroupBox>
                                    <TextBlock Foreground="#FF8AA4C8" TextWrapping="Wrap" Margin="0,10,0,0"
                                               Text="Les images placées dans le dossier du projet (à côté du .rvt) y sont référencées en chemin relatif : le dossier reste déplaçable. Une image introuvable à l'export est signalée, le document est produit sans elle."/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
