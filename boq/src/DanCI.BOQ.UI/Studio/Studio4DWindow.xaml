<Window x:Class="DanCI.BOQ.UI.Studio.Studio4DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DanCI.BOQ.UI.ViewModels"
        Title="DanCI — Studio 4D" Width="1240" Height="340" MinWidth="820" MinHeight="150"
        WindowStartupLocation="Manual" ShowInTaskbar="False" FontSize="12"
        Background="{DynamicResource Fx.Night}" Foreground="{DynamicResource Fx.Text}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <vm:PathGeometryConverter x:Key="PathGeo"/>
    </Window.Resources>
    <DockPanel>
        <!-- Bandeau : date, lecture, indicateurs -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Fx.Panel2}" BorderBrush="{DynamicResource Fx.Ink.Cyan}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="STUDIO 4D — CONSTRUCTION DU BÂTIMENT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Fx.Ink.Cyan}"/>
                    <TextBlock Text="{Binding DateText}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Fx.Ink.Strong}">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FF00E5FF" BlurRadius="12" ShadowDepth="0" Opacity="0.45"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="{Binding DayText}" Foreground="{DynamicResource Fx.Muted}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="24,0" VerticalAlignment="Center">
                    <WrapPanel>
                        <Button Content="⏮" Width="34" Command="{Binding StartCommand}" ToolTip="Démarrage du chantier"/>
                        <Button Content="◀" Width="34" Margin="4,0,0,0" Command="{Binding StepCommand}" CommandParameter="-" ToolTip="Reculer d'un pas"/>
                        <Button Content="{Binding PlayLabel}" Width="110" Margin="4,0,0,0" FontWeight="Bold" Command="{Binding PlayCommand}"/>
                        <Button Content="▶" Width="34" Margin="4,0,0,0" Command="{Binding StepCommand}" CommandParameter="+" ToolTip="Avancer d'un pas"/>
                        <Button Content="⏭" Width="34" Margin="4,0,0,0" Command="{Binding EndCommand}" ToolTip="Réception (bâtiment complet)"/>
                        <ComboBox Width="200" Margin="12,0,0,0" ItemsSource="{Binding SpeedChoices}" SelectedItem="{Binding Speed}"
                                  ToolTip="Images par seconde. Chaque image attend que Revit ait dessiné la précédente : la cadence reste régulière, même si le modèle est lourd."/>
                        <ComboBox Width="150" Margin="8,0,0,0" ItemsSource="{Binding StepChoices}" SelectedItem="{Binding StepSize}"
                                  ToolTip="Avancement du chantier à chaque image : petit pas = construction plus fluide ; grand pas = chantier plus vite parcouru."/>
                        <CheckBox Content="Rotation du bâtiment" IsChecked="{Binding Rotate}" VerticalAlignment="Center" Margin="12,0,0,0"
                                  ToolTip="La caméra de la vue 3D tourne autour du bâtiment pendant la lecture."/>
                        <ComboBox Width="130" Margin="6,0,0,0" ItemsSource="{Binding TurnChoices}" SelectedItem="{Binding TurnSpeed}"
                                  ToolTip="Vitesse de rotation du bâtiment, indépendante de la vitesse de construction."/>
                        <Button Content="⟲" Width="30" Margin="6,0,0,0" Command="{Binding TurnCommand}" CommandParameter="-" ToolTip="Tourner de 30°"/>
                        <Button Content="⟳" Width="30" Margin="4,0,0,0" Command="{Binding TurnCommand}" CommandParameter="+" ToolTip="Tourner de 30°"/>
                        <CheckBox Content="Couleurs d'état (en cours en jaune)" IsChecked="{Binding StateColors}" VerticalAlignment="Center" Margin="12,0,0,0"
                                  ToolTip="Comme SYNCHRO : ce qui se construit est en jaune, ce qui est fini prend sa couleur réelle. Décoché : couleur du lot."/>
                        <CheckBox Content="Liens" IsChecked="{Binding Boq.ShowGanttLinks}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <Button Content="{Binding RecordLabel}" Command="{Binding RecordCommand}" Margin="12,0,0,0" Tag="orange"
                                ToolTip="Enregistre la simulation en vidéo (AVI), date incrustée, du début du chantier jusqu'à la vue de face finale — à montrer au client, à mettre dans une présentation."/>
                        <Button Content="{Binding GanttToggleLabel}" Margin="12,0,0,0" Click="ToggleGantt_Click"
                                ToolTip="Masquer le Gantt : il ne reste qu'un bandeau, la vue 3D de Revit occupe presque tout l'écran."/>
                    </WrapPanel>
                    <Slider Minimum="0" Maximum="{Binding MaxDay}" Value="{Binding Day}" Margin="0,8,0,0" IsSnapToTickEnabled="True" TickFrequency="1"
                            ToolTip="Faites glisser la date : la vue 3D de Revit suit."/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#1A3DDC84" BorderBrush="#FF3DDC84" BorderThickness="0,3,0,0" CornerRadius="4" Padding="10,5" Margin="0,0,8,0" MinWidth="86">
                            <StackPanel>
                                <TextBlock Text="TERMINÉES" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Fx.Muted}"/>
                                <TextBlock Text="{Binding DoneText}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Fx.Ink.Green}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1AFFC24D" BorderBrush="#FFFFC24D" BorderThickness="0,3,0,0" CornerRadius="4" Padding="10,5" Margin="0,0,8,0" MinWidth="86">
                            <StackPanel>
                                <TextBlock Text="EN COURS" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Fx.Muted}"/>
                                <TextBlock Text="{Binding RunningText}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Fx.Ink.Amber}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1A00E5FF" BorderBrush="#FF00E5FF" BorderThickness="0,3,0,0" CornerRadius="4" Padding="10,5" MinWidth="120">
                            <StackPanel>
                                <TextBlock Text="AVANCEMENT (MONTANT)" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Fx.Muted}"/>
                                <TextBlock Text="{Binding PercentText}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Fx.Ink.Cyan}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border Width="220" Height="6" Background="{DynamicResource Fx.Line}" HorizontalAlignment="Left" Margin="0,6,0,0" CornerRadius="3">
                        <Border Width="{Binding PercentWidth}" HorizontalAlignment="Left" CornerRadius="3">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF3DDC84" Offset="0"/>
                                    <GradientStop Color="#FF00E5FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        <!-- Taches en cours et legende -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Fx.Panel2}" BorderBrush="{DynamicResource Fx.Line}" BorderThickness="0,1,0,0" Padding="12,6">
            <StackPanel>
                <TextBlock Text="{Binding CurrentTasks}" FontWeight="SemiBold" Foreground="{DynamicResource Fx.Ink.Amber}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding RevitStatus}" Foreground="{DynamicResource Fx.Ink.Cyan}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding CadenceText}" Foreground="{DynamicResource Fx.Ink.Green}" Margin="0,2,0,0"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Fx.Muted}" FontSize="11" Margin="0,2,0,0"
                           Text="Dans Revit, vue 3D « DanCI — Planning 4D » : terminé = aspect réel · en cours = jaune (ou couleur du lot) · à venir = masqué · le contexte (terrain, voisins, grue, éléments hors planning) reste visible. Vue seulement (masquage temporaire et couleurs de CETTE vue, retirés à la fermeture). Liens animés = enchaînements en cours ; rouges = chemin critique."/>
            </StackPanel>
        </Border>
        <!-- Gantt qui defile -->
        <Grid Visibility="{Binding ShowGantt, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <!-- Graphiques facon SYNCHRO : courbe en S et histogramme hebdomadaire, curseur de date -->
        <Border Grid.Column="1" Background="{DynamicResource Fx.Panel2}" BorderBrush="{DynamicResource Fx.Line}" BorderThickness="1,0,0,0" Padding="10,6">
            <StackPanel Width="300">
                <TextBlock Text="COURBE EN S — montant cumulé prévu" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Fx.Ink.Cyan}"/>
                <Canvas Width="300" Height="56" Margin="0,4,0,0" ClipToBounds="True">
                    <Rectangle Width="300" Height="56" Fill="#FF0B1426"/>
                    <Line X1="0" Y1="28" X2="300" Y2="28" Stroke="#FF1E3A5F" StrokeThickness="0.5" StrokeDashArray="3 3"/>
                    <Polyline Points="{Binding SCurvePoints}" Stroke="#FF5F7AA0" StrokeThickness="1.5"/>
                    <Polyline Points="{Binding SCurveDonePoints}" Stroke="#FF00E5FF" StrokeThickness="2.5"/>
                    <Line X1="{Binding ChartCursorX}" X2="{Binding ChartCursorX}" Y1="0" Y2="56" Stroke="#FFFF4D6D" StrokeThickness="1.2"/>
                    <Ellipse Width="7" Height="7" Fill="#FFFFC21A" Canvas.Left="{Binding ChartCursorX}" Canvas.Top="{Binding ChartCursorY}" Margin="-3.5,-3.5,0,0"/>
                </Canvas>
                <TextBlock Text="{Binding CumulText}" FontSize="10" Foreground="{DynamicResource Fx.Muted}" Margin="0,1,0,3"/>
                <TextBlock Text="MONTANT PAR SEMAINE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Fx.Ink.Cyan}"/>
                <Canvas Width="300" Height="56" Margin="0,4,0,0" ClipToBounds="True">
                    <Rectangle Width="300" Height="56" Fill="#FF0B1426"/>
                    <ItemsControl ItemsSource="{Binding WeekBars}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Fill}" ToolTip="{Binding Tooltip}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Line X1="{Binding ChartCursorX}" X2="{Binding ChartCursorX}" Y1="0" Y2="56" Stroke="#FFFF4D6D" StrokeThickness="1.2"/>
                </Canvas>
            </StackPanel>
        </Border>
        <ScrollViewer x:Name="GanttScroll" Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="440" Background="{DynamicResource Fx.Panel2}" BorderBrush="{DynamicResource Fx.Line}" BorderThickness="0,0,0,1">
                        <Grid Margin="6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Tâche (lot · niveau)" FontWeight="Bold" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            <TextBlock Grid.Column="2" Text="Début" FontWeight="Bold" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,4"/>
                            <TextBlock Grid.Column="3" Text="Fin" FontWeight="Bold" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,4"/>
                        </Grid>
                    </Border>
                    <Canvas Width="{Binding Boq.GanttWidth}" Height="44" Background="{DynamicResource Fx.Panel2}">
                        <ItemsControl ItemsSource="{Binding Boq.GanttMonths}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding Left}"/></Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding Width}" Height="22" BorderBrush="{DynamicResource Fx.Line}" BorderThickness="1,0,0,1">
                                        <TextBlock Text="{Binding Label}" FontWeight="Bold" Foreground="{DynamicResource Fx.Ink.Cyan}" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Boq.GanttWeeks}" Canvas.Top="22">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding Left}"/></Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding Width}" Height="22" BorderBrush="{DynamicResource Fx.Line}" BorderThickness="1,0,0,0">
                                        <TextBlock Text="{Binding Label}" FontSize="9" Foreground="{DynamicResource Fx.Muted}" Margin="2,4,0,0"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                </StackPanel>
                <Grid>
                    <ItemsControl ItemsSource="{Binding Boq.GanttRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="26">
                                    <Border Background="{DynamicResource Fx.Panel2}" Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}"
                                            BorderBrush="{DynamicResource Fx.Ink.Cyan}" BorderThickness="0,0,0,1">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{DynamicResource Fx.Ink.Cyan}" VerticalAlignment="Center" Margin="8,0"/>
                                    </Border>
                                    <Border x:Name="RowBack" Visibility="{Binding IsTask, Converter={StaticResource BoolToVis}}" Background="Transparent">
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Tooltip}">
                                            <Grid Width="434" Margin="6,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="64"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="Icon" Text="{Binding StateIcon}" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource Fx.Muted}"/>
                                                <TextBlock x:Name="TaskName" Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Start}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Fx.Muted}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Finish}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Fx.Muted}"/>
                                            </Grid>
                                            <Canvas Width="{Binding DataContext.Boq.GanttWidth, RelativeSource={RelativeSource AncestorType=Window}}" Height="26">
                                                <Rectangle Canvas.Left="{Binding DataContext.Boq.CursorLeft, RelativeSource={RelativeSource AncestorType=Window}}" Width="2" Height="26"
                                                           Fill="{DynamicResource Fx.Ink.Green}" Opacity="0.9"/>
                                                <Border x:Name="Bar" Canvas.Left="{Binding BarLeft}" Canvas.Top="4" Width="{Binding BarWidth}" Height="16" CornerRadius="3"
                                                        Background="{Binding Color}" BorderBrush="#55000000" BorderThickness="1" Opacity="0.55">
                                                    <TextBlock Text="{Binding Duration}" FontSize="9" FontWeight="Bold" Foreground="#FF070D1A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Canvas>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter TargetName="RowBack" Property="Background" Value="#3300E5FF"/>
                                        <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                                        <Setter TargetName="Bar" Property="BorderBrush" Value="#FFFFFFFF"/>
                                        <Setter TargetName="Bar" Property="BorderThickness" Value="2"/>
                                        <Setter TargetName="Icon" Property="Foreground" Value="#FFFFC24D"/>
                                        <Setter TargetName="TaskName" Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter TargetName="Bar" Property="Opacity" Value="0.95"/>
                                        <Setter TargetName="Icon" Property="Foreground" Value="#FF3DDC84"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                        <Setter TargetName="TaskName" Property="Foreground" Value="#FFFF6B85"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Liens : animes (pointilles qui defilent) quand l'enchainement est en cours -->
                    <ItemsControl ItemsSource="{Binding Boq.GanttLinks}" Margin="440,0,0,0" IsHitTestVisible="False"
                                  Visibility="{Binding Boq.ShowGanttLinks, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Opacity="{Binding Opacity}">
                                    <Path x:Name="LinkLine" Data="{Binding Data, Converter={StaticResource PathGeo}}" Stroke="{Binding Color}" StrokeThickness="{Binding Thickness}">
                                        <Path.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset" From="0" To="-16" Duration="0:0:0.8" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Path.Triggers>
                                    </Path>
                                    <Path Data="{Binding Arrow, Converter={StaticResource PathGeo}}" Fill="{Binding Color}"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="LinkLine" Property="StrokeDashArray" Value="3 1"/>
                                        <Setter TargetName="LinkLine" Property="StrokeThickness" Value="2.2"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
