<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Extraction des quantites depuis l'API Revit (lecture seule). Traduit les elements Revit
    en objets du Core ; aucune regle de metre ici, seulement de la mesure.
  -->
  <PropertyGroup>
    <TargetFramework>$(DanCIDotNet)-windows</TargetFramework>
    <RootNamespace>DanCI.BOQ.RevitAdapter</RootNamespace>
    <AssemblyName>DanCI.BOQ.RevitAdapter</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <!--
    API Revit : paquets Nice3point, version alignee sur la configuration (2025.*, 2026.*, 2027.*).
    ExcludeAssets=runtime : RevitAPI.dll n'est JAMAIS copiee dans la sortie, Revit fournit la sienne.
  -->
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DanCI.BOQ.Core\DanCI.BOQ.Core.csproj" />
  </ItemGroup>
</Project>
