// DanCI — Métré & BOQ : PLANIFICATION DES TRAVAUX (schéma 1).
//
// TOUTES CES VALEURS SONT DES HYPOTHÈSES À VALIDER par le conducteur de travaux : rendements de
// VOS équipes, nombre d'équipes, calendrier. La durée d'une tâche = Σ (quantité de l'article sur
// le niveau ÷ rendement par jour) ÷ nombre d'équipes du lot, arrondie au jour supérieur.
// Enchaînement : installation → démolitions → terrassements → fondations → niveau par niveau
// (gros œuvre, puis maçonnerie, réseaux, menuiseries, finitions) → toiture → VRD.
{
  "schemaVersion": 1,
  "joursOuvresParSemaine": 6,          // 6 = lundi-samedi, 5 = lundi-vendredi ; le dimanche est chômé
  "heuresParJour": 8,                    // heures de travail par jour : temps unitaires en heures-homme
  "effectifs": { "00": 3, "DEM": 3, "01": 4, "02": 5, "03": 6, "04": 4, "05": 3, "06": 4, "07": 2, "08": 3, "09": 2, "10": 2, "11": 4, "12": 2 },  // ouvriers par équipe et par lot (temps unitaires) ; « effectif » sur un rendement le remplace
  "installationChantierJours": 10,     // si l'installation n'est pas un article du BOQ
  "delaiEntreNiveauxJours": 7,         // décoffrage / étaiement avant le gros œuvre du niveau suivant
  "delaiMaconnerieJours": 3,           // après le gros œuvre d'un niveau, avant sa maçonnerie
  "dureeMinJours": 1,
  "feries": [ "2026-12-25", "2027-01-01", "2027-01-04", "2027-05-01", "2027-06-30" ],
  // Équipes par lot (1 par défaut) : elles se partagent les quantités du niveau.
  "equipes": [
    { "lot": "03", "equipes": 2 },
    { "lot": "05", "equipes": 2 },
    { "lot": "08", "equipes": 2 }
  ],
  // Rendement d'UNE équipe par jour ouvré. Premier motif qui correspond (code d'article, jokers * ?) ET unité.
  "rendements": [
    { "articles": "01.*", "unite": "m3", "parJour": 12,  "note": "terrassement manuel / petit engin" },
    { "articles": "01.*", "unite": "m2", "parJour": 150 },
    { "articles": "02.*", "unite": "m3", "parJour": 6,   "note": "béton coulé à la bétonnière" },
    { "articles": "02.*", "unite": "m2", "parJour": 18,  "note": "coffrage" },
    { "articles": "02.*", "unite": "kg", "parJour": 350, "note": "armatures façonnées et posées" },
    { "articles": "02.*", "unite": "ml", "parJour": 8,   "note": "pieux" },
    { "articles": "03.*", "unite": "m3", "parJour": 6 },
