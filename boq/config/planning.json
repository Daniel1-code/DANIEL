    { "articles": "06.*", "unite": "m2", "parJour": 40 },
    { "articles": "06.*", "unite": "ml", "parJour": 25 },
    { "articles": "07.*", "unite": "U",  "parJour": 4 },
    { "articles": "07.*", "unite": "ml", "parJour": 15 },
    { "articles": "07.*", "unite": "m2", "parJour": 12 },
    { "articles": "08.01", "unite": "m2", "parJour": 25, "note": "enduit" },
