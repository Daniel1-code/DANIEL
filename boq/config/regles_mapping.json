//              Volume, Terrassement, BetonProprete, Isolation (couches isolantes)
//  categorie : nom BuiltInCategory, INDÉPENDANT DE LA LANGUE de Revit (OST_Walls, OST_Floors…)
//  famille, type, materiau, niveau : texte, jokers * et ? admis, casse ignorée
//  parametres : { "NomDuParametre": "valeur" }
//
// L'unité de la quantité doit être celle de l'article : le moteur ne convertit jamais.
