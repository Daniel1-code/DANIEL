<Window x:Class="ArmaturesPoteaux.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ArmaturesPoteaux.UI"
        Title="Armatures de poteaux" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <local:InverseBooleanConverter x:Key="Invert"/>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="3,2,3,2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel>

                <GroupBox Header="Norme et materiaux">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Reglement"
                                   Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbCode" Grid.Row="0" Grid.Column="1" SelectedIndex="0">
                            <ComboBoxItem Content="Eurocode 2 (EN 1992-1-1)"/>
                            <ComboBoxItem Content="ACI 318-19"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Beton f_ck (MPa)"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtFck" Grid.Row="1" Grid.Column="1"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Acier f_yk (MPa)"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtFyk" Grid.Row="2" Grid.Column="1"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Effort normal N_Ed (kN)"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtNed" Grid.Row="3" Grid.Column="1"
                                 ToolTip="Laisser 0 si l'effort n'est pas connu : seul le minimum 0,002 Ac sera applique."/>

                        <CheckBox x:Name="chkSeismic" Grid.Row="4" Grid.ColumnSpan="2"
                                  Content="Zone sismique (zones critiques allongees)"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Enrobage">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Enrobage c_nom (mm)"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtCover" Grid.Row="0" Grid.Column="1"
                                 ToolTip="Mesure jusqu'au nu exterieur des cadres."/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Granulat d_g (mm)"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtAggregate" Grid.Row="1" Grid.Column="1"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Armatures longitudinales">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Taux vise (%)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtRatio" Grid.Column="1"
                                     ToolTip="Le calcul retient toujours au moins le minimum reglementaire."/>
                        </Grid>

                        <CheckBox x:Name="chkAutoDiameter" Content="Diametre choisi automatiquement"/>
                        <Grid IsEnabled="{Binding IsChecked, ElementName=chkAutoDiameter,
                                                  Converter={StaticResource Invert}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Diametre impose (mm)" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbDiameter" Grid.Column="1"/>
                        </Grid>

                        <CheckBox x:Name="chkAutoCount" Content="Nombre de barres choisi automatiquement"/>
                        <Grid IsEnabled="{Binding IsChecked, ElementName=chkAutoCount,
                                                  Converter={StaticResource Invert}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Barres par face // X"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtNx" Grid.Row="0" Grid.Column="1"/>
                            <TextBlock Grid.Row="1" Text="Barres par face // Y"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtNy" Grid.Row="1" Grid.Column="1"/>
                            <TextBlock Grid.Row="2" Text="Barres (section ronde)"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtNcirc" Grid.Row="2" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Cadres et epingles">
                    <StackPanel>
                        <CheckBox x:Name="chkAutoTransverse"
                                  Content="Diametre et espacement calcules automatiquement"/>
                        <Grid IsEnabled="{Binding IsChecked, ElementName=chkAutoTransverse,
                                                  Converter={StaticResource Invert}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Diametre cadre (mm)"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbStirrupDiameter" Grid.Row="0" Grid.Column="1"/>
                            <TextBlock Grid.Row="1" Text="Espacement (mm)"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtSpacing" Grid.Row="1" Grid.Column="1"/>
                        </Grid>

                        <CheckBox x:Name="chkCriticalZones"
                                  Content="Zones critiques resserrees en pied et en tete"/>
                        <CheckBox x:Name="chkCrossTies"
                                  Content="Epingles automatiques si entraxe &gt; 150 mm"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Longueurs">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Premier cadre a (mm)"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtFirstOffset" Grid.Row="0" Grid.Column="1"/>

                        <TextBlock Grid.Row="1" Text="Retrait en pied (mm)"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtBottomOffset" Grid.Row="1" Grid.Column="1"/>

                        <CheckBox x:Name="chkAutoTop" Grid.Row="2" Grid.ColumnSpan="2"
                                  Content="Attentes = longueur de recouvrement calculee"/>

                        <TextBlock Grid.Row="3" Text="Attentes imposees (mm)"
                                   Style="{StaticResource FieldLabel}"
                                   IsEnabled="{Binding IsChecked, ElementName=chkAutoTop,
                                                       Converter={StaticResource Invert}}"/>
                        <TextBox x:Name="txtTopExtension" Grid.Row="3" Grid.Column="1"
                                 IsEnabled="{Binding IsChecked, ElementName=chkAutoTop,
                                                     Converter={StaticResource Invert}}"/>
                    </Grid>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="240"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="grdResults" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                      SelectionChanged="OnResultSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Poteau" Binding="{Binding Poteau}" Width="2*"/>
                    <DataGridTextColumn Header="Section (mm)" Binding="{Binding Section}" Width="*"/>
                    <DataGridTextColumn Header="Hauteur (mm)" Binding="{Binding Hauteur}" Width="*"/>
                    <DataGridTextColumn Header="Longitudinales" Binding="{Binding Longitudinales}" Width="*"/>
                    <DataGridTextColumn Header="Transversales" Binding="{Binding Transversales}" Width="2*"/>
                    <DataGridTextColumn Header="Taux" Binding="{Binding Taux}" Width="0.7*"/>
                    <DataGridTextColumn Header="Recouvr. (mm)" Binding="{Binding Recouvrement}" Width="*"/>
                    <DataGridTextColumn Header="Etat" Binding="{Binding Etat}" Width="0.7*"/>
                </DataGrid.Columns>
            </DataGrid>

            <GroupBox Grid.Row="1" Header="Note de calcul" Margin="0,10,0,0">
                <TextBox x:Name="txtNotes" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                         Background="#FFFAFAFA" BorderThickness="0"/>
            </GroupBox>
        </Grid>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="txtStatus" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="#FF444444"/>
            <Button x:Name="btnClose" DockPanel.Dock="Right" Content="Fermer" Width="110" Height="30"
                    Margin="8,0,0,0" Click="OnCloseClick"/>
            <Button x:Name="btnGenerate" DockPanel.Dock="Right" Content="Generer les armatures"
                    Width="180" Height="30" Margin="8,0,0,0" IsDefault="True" Click="OnGenerateClick"/>
            <Button x:Name="btnExport" DockPanel.Dock="Right" Content="Exporter la note"
                    Width="140" Height="30" Margin="8,0,0,0" Click="OnExportClick"/>
            <Button x:Name="btnCalculate" DockPanel.Dock="Right" Content="Calculer"
                    Width="110" Height="30" Margin="8,0,0,0" Click="OnCalculateClick"/>
        </DockPanel>
    </Grid>
</Window>
