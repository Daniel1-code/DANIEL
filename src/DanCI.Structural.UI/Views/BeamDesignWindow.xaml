<Window x:Class="DanCI.Structural.UI.Views.BeamDesignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DanCI.Structural.UI.Converters"
        Title="DanCI Structural Studio - Beam Design" Height="820" Width="1340"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <local:InverseBooleanConverter x:Key="Invert"/>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="3,2,3,2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel>

                <GroupBox Header="Norme et materiaux">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Annexe Nationale" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbAnnex" Grid.Row="0" Grid.Column="1" SelectedIndex="0">
                            <ComboBoxItem Content="Valeurs recommandees EN 1992-1-1"/>
                            <ComboBoxItem Content="Annexe Nationale francaise (a completer)"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Text="Beton f_ck (MPa)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtFck" Grid.Row="1" Grid.Column="1"/>

                        <TextBlock Grid.Row="2" Text="Acier f_yk (MPa)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtFyk" Grid.Row="2" Grid.Column="1"/>

                        <TextBlock Grid.Row="3" Text="Redistribution delta" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtRedistribution" Grid.Row="3" Grid.Column="1"
                                 ToolTip="1,00 = aucune redistribution. Limite la hauteur d'axe neutre (EC2 5.5)."/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Sollicitations de calcul">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="M en travee (kN.m)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtMspan" Grid.Row="0" Grid.Column="1"/>

                        <TextBlock Grid.Row="1" Text="M appui gauche (kN.m)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtMleft" Grid.Row="1" Grid.Column="1"
                                 ToolTip="Valeur absolue du moment negatif. 0 si l'appui est simple."/>

                        <TextBlock Grid.Row="2" Text="M appui droit (kN.m)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtMright" Grid.Row="2" Grid.Column="1"/>

                        <TextBlock Grid.Row="3" Text="V appui gauche (kN)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtVleft" Grid.Row="3" Grid.Column="1"/>

                        <TextBlock Grid.Row="4" Text="V appui droit (kN)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtVright" Grid.Row="4" Grid.Column="1"/>

                        <TextBlock Grid.Row="5" Text="Conditions d'appui" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbSpanKind" Grid.Row="5" Grid.Column="1">
                            <ComboBoxItem Content="Travee isostatique"/>
                            <ComboBoxItem Content="Travee de rive"/>
                            <ComboBoxItem Content="Travee intermediaire"/>
                            <ComboBoxItem Content="Console"/>
                        </ComboBox>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Table collaborante">
                    <StackPanel>
                        <CheckBox x:Name="chkTSection" Content="Poutre en T avec la dalle portee"
                                  ToolTip="La dalle n'appartient pas a l'element poutre : c'est vous qui la declarez."/>
                        <Grid IsEnabled="{Binding IsChecked, ElementName=chkTSection}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="165"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Largeur de table (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtFlangeWidth" Grid.Row="0" Grid.Column="1"/>
                            <TextBlock Grid.Row="1" Text="Epaisseur dalle (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtFlangeThickness" Grid.Row="1" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Enrobage et durabilite">
                    <StackPanel>
                        <CheckBox x:Name="chkAutoCover" Content="Enrobage calcule (EC2 4.4.1)"/>
                        <Grid IsEnabled="{Binding IsChecked, ElementName=chkAutoCover}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="165"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Classe d'exposition" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbExposure" Grid.Column="1">
                                <ComboBoxItem Content="X0 - aucun risque"/>
                                <ComboBoxItem Content="XC1 - sec ou humide en permanence"/>
                                <ComboBoxItem Content="XC2 - humide, rarement sec"/>
                                <ComboBoxItem Content="XC3 - humidite moderee"/>
                                <ComboBoxItem Content="XC4 - alternance humide / sec"/>
                                <ComboBoxItem Content="XD1 - chlorures, humidite moderee"/>
                                <ComboBoxItem Content="XD2 - chlorures, humide"/>
                                <ComboBoxItem Content="XD3 - chlorures, alternance"/>
                                <ComboBoxItem Content="XS1 - air marin"/>
                                <ComboBoxItem Content="XS2 - immersion marine"/>
                                <ComboBoxItem Content="XS3 - zone de marnage"/>
                            </ComboBox>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="165"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Enrobage impose (mm)"
                                       Style="{StaticResource FieldLabel}"
                                       IsEnabled="{Binding IsChecked, ElementName=chkAutoCover,
                                                           Converter={StaticResource Invert}}"/>
                            <TextBox x:Name="txtCover" Grid.Row="0" Grid.Column="1"
                                     IsEnabled="{Binding IsChecked, ElementName=chkAutoCover,
                                                         Converter={StaticResource Invert}}"/>
                            <TextBlock Grid.Row="1" Text="Granulat d_g (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtAggregate" Grid.Row="1" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Armatures">
                    <StackPanel>
                        <CheckBox x:Name="chkAutoDiameter" Content="Diametre longitudinal automatique"/>
                        <Grid IsEnabled="{Binding IsChecked, ElementName=chkAutoDiameter,
                                                  Converter={StaticResource Invert}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="165"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Diametre impose (mm)" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbDiameter" Grid.Column="1"/>
                        </Grid>

                        <CheckBox x:Name="chkAutoStirrup" Content="Diametre de cadre automatique"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="165"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Diametre cadre (mm)"
                                       Style="{StaticResource FieldLabel}"
                                       IsEnabled="{Binding IsChecked, ElementName=chkAutoStirrup,
                                                           Converter={StaticResource Invert}}"/>
                            <ComboBox x:Name="cmbStirrupDiameter" Grid.Row="0" Grid.Column="1"
                                      IsEnabled="{Binding IsChecked, ElementName=chkAutoStirrup,
                                                          Converter={StaticResource Invert}}"/>
                            <TextBlock Grid.Row="1" Text="Brins par cadre" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtLegs" Grid.Row="1" Grid.Column="1"/>
                            <TextBlock Grid.Row="2" Text="Lits maximum" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtMaxLayers" Grid.Row="2" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="250"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="grdResults" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                      SelectionChanged="OnResultSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Element" Binding="{Binding Element}" Width="2*"/>
                    <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="1.4*"/>
                    <DataGridTextColumn Header="Portee" Binding="{Binding Portee}" Width="0.8*"/>
                    <DataGridTextColumn Header="Travee" Binding="{Binding Travee}" Width="1.2*"/>
                    <DataGridTextColumn Header="Chapeaux" Binding="{Binding Chapeaux}" Width="1.4*"/>
                    <DataGridTextColumn Header="Cadres" Binding="{Binding Cadres}" Width="2*"/>
                    <DataGridTextColumn Header="Acier (kg)" Binding="{Binding Poids}" Width="0.9*"/>
                    <DataGridTextColumn Header="Taux" Binding="{Binding Utilisation}" Width="0.7*"/>
                    <DataGridTextColumn Header="Etat" Binding="{Binding Etat}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <GroupBox Grid.Row="1" Header="Note de calcul" Margin="0,10,0,0">
                <TextBox x:Name="txtNotes" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                         Background="#FFFAFAFA" BorderThickness="0"/>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="2" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Poutre selectionnee">
                <Image x:Name="imgBeam" Stretch="Uniform" SnapsToDevicePixels="True"/>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="Quantitatif">
                <TextBlock x:Name="txtQuantities" TextWrapping="Wrap" LineHeight="18"
                           Text="Cliquez sur Calculer."/>
            </GroupBox>
        </Grid>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="txtStatus" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="#FF444444"/>
            <Button x:Name="btnClose" DockPanel.Dock="Right" Content="Fermer" Width="100" Height="30"
                    Margin="8,0,0,0" Click="OnCloseClick"/>
            <Button x:Name="btnGenerate" DockPanel.Dock="Right" Content="Generer les armatures"
                    Width="175" Height="30" Margin="8,0,0,0" IsDefault="True" Click="OnGenerateClick"/>
            <Button x:Name="btnExport" DockPanel.Dock="Right" Content="Exporter la note"
                    Width="135" Height="30" Margin="8,0,0,0" Click="OnExportClick"/>
            <Button x:Name="btnCalculate" DockPanel.Dock="Right" Content="Calculer"
                    Width="105" Height="30" Margin="8,0,0,0" Click="OnCalculateClick"/>
        </DockPanel>
    </Grid>
</Window>
