<Window x:Class="DanCI.Structural.UI.Views.StairDesignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DanCI.Structural.UI.Converters"
        Title="DanCI Structural Studio - Stair Design" Height="880" Width="1420"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <local:InverseBooleanConverter x:Key="Invert"/>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="3,2,3,2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="385"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel>

                <GroupBox Header="Norme et materiaux">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="185"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Annexe Nationale" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbAnnex" Grid.Row="0" Grid.Column="1" SelectedIndex="0">
                            <ComboBoxItem Content="Valeurs recommandees EN 1992-1-1"/>
                            <ComboBoxItem Content="Annexe Nationale francaise (a completer)"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Text="Beton f_ck (MPa)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtFck" Grid.Row="1" Grid.Column="1"/>

                        <TextBlock Grid.Row="2" Text="Acier f_yk (MPa)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtFyk" Grid.Row="2" Grid.Column="1"/>

                        <TextBlock Grid.Row="3" Text="Poids beton (kN/m3)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtUnitWeight" Grid.Row="3" Grid.Column="1"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Geometrie de la volee">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="185"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Contremarches (nombre)" Style="{StaticResource FieldLabel}"
                                       ToolTip="n contremarches ne font que n - 1 girons : la derniere debouche sur le palier."/>
                            <TextBox x:Name="txtRiserCount" Grid.Row="0" Grid.Column="1"
                                     TextChanged="OnGeometryChanged"/>

                            <TextBlock Grid.Row="1" Text="Hauteur R (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtRiser" Grid.Row="1" Grid.Column="1"
                                     TextChanged="OnGeometryChanged"/>

                            <TextBlock Grid.Row="2" Text="Giron G (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtTread" Grid.Row="2" Grid.Column="1"
                                     TextChanged="OnGeometryChanged"/>

                            <TextBlock Grid.Row="3" Text="Paillasse t (mm)" Style="{StaticResource FieldLabel}"
                                       ToolTip="Mesuree PERPENDICULAIREMENT a la pente. C'est elle qui pilote tout le poids propre."/>
                            <TextBox x:Name="txtWaist" Grid.Row="3" Grid.Column="1"
                                     TextChanged="OnGeometryChanged"/>

                            <TextBlock Grid.Row="4" Text="Largeur de volee (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtWidth" Grid.Row="4" Grid.Column="1"/>

                            <TextBlock Grid.Row="5" Text="Epaisseur palier (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtLandingThickness" Grid.Row="5" Grid.Column="1"/>

                            <TextBlock Grid.Row="6" Text="Palier dans la portee (mm)" Style="{StaticResource FieldLabel}"
                                       ToolTip="Longueur de palier comprise entre le nu de la volee et l'appui."/>
                            <TextBox x:Name="txtLandingSpan" Grid.Row="6" Grid.Column="1"
                                     TextChanged="OnGeometryChanged"/>
                        </Grid>
                        <TextBlock x:Name="txtGeometrySummary" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="#FF555555" FontSize="11"/>
                        <TextBlock x:Name="txtGeometryOrigin" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="#FF804000" FontSize="11"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Appui et charges">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="185"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Mode d'appui" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbSpanKind" Grid.Row="0" Grid.Column="1"
                                      SelectionChanged="OnGeometryChanged">
                                <ComboBoxItem Content="Volee + palier entre appuis"/>
                                <ComboBoxItem Content="Volee seule entre appuis"/>
                                <ComboBoxItem Content="Portee transversale (limons, voiles)"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Text="Categorie d'usage" Style="{StaticResource FieldLabel}"
                                       ToolTip="EN 1991-1-1 6.3.1(1) : un escalier prend la categorie de la zone qu'il dessert."/>
                            <ComboBox x:Name="cmbCategory" Grid.Row="1" Grid.Column="1" SelectedIndex="0">
                                <ComboBoxItem Content="A - Habitation"/>
                                <ComboBoxItem Content="B - Bureaux"/>
                                <ComboBoxItem Content="C - Lieux de reunion"/>
                                <ComboBoxItem Content="D - Commerces"/>
                                <ComboBoxItem Content="E - Stockage"/>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Text="Charge q_k (kN/m2)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtVariable" Grid.Row="2" Grid.Column="1"/>

                            <TextBlock Grid.Row="3" Text="Revetement marche (kN/m2)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtTreadFinish" Grid.Row="3" Grid.Column="1"/>

                            <TextBlock Grid.Row="4" Text="Sous-face (kN/m2)" Style="{StaticResource FieldLabel}"
                                       ToolTip="Appliquee sur la surface inclinee reelle, donc divisee par cos alpha."/>
                            <TextBox x:Name="txtSoffitFinish" Grid.Row="4" Grid.Column="1"/>

                            <TextBlock Grid.Row="5" Text="Charge concentree Q_k (kN)" Style="{StaticResource FieldLabel}"
                                       ToolTip="EN 1991-1-1 6.3.1.2(1), tableau 6.2 : s'applique en ALTERNATIVE a q_k, sur 50 x 50 mm. 0 desactive la verification."/>
                            <TextBox x:Name="txtConcentrated" Grid.Row="5" Grid.Column="1"/>
                        </Grid>
                        <CheckBox x:Name="chkSelfWeight"
                                  Content="Inclure le poids propre (paillasse et marches)"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Enrobage">
                    <StackPanel>
                        <CheckBox x:Name="chkAutoCover" Content="Enrobage calcule (EC2 art. 4.4.1)"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="185"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Classe d'exposition" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbExposure" Grid.Row="0" Grid.Column="1">
                                <ComboBoxItem Content="X0 - aucun risque"/>
                                <ComboBoxItem Content="XC1 - sec ou humide en permanence"/>
                                <ComboBoxItem Content="XC2 - humide, rarement sec"/>
                                <ComboBoxItem Content="XC3 - humidite moderee"/>
                                <ComboBoxItem Content="XC4 - alternance humide / sec"/>
                                <ComboBoxItem Content="XD1 - chlorures, humidite moderee"/>
                                <ComboBoxItem Content="XD2 - chlorures, humide"/>
                                <ComboBoxItem Content="XD3 - chlorures, alternance"/>
                                <ComboBoxItem Content="XS1 - air marin"/>
                                <ComboBoxItem Content="XS2 - immersion marine"/>
                                <ComboBoxItem Content="XS3 - zone de marnage"/>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Text="Enrobage impose (mm)" Style="{StaticResource FieldLabel}"
                                       IsEnabled="{Binding IsChecked, ElementName=chkAutoCover,
                                                           Converter={StaticResource Invert}}"/>
                            <TextBox x:Name="txtCover" Grid.Row="1" Grid.Column="1"
                                     IsEnabled="{Binding IsChecked, ElementName=chkAutoCover,
                                                         Converter={StaticResource Invert}}"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Ferraillage et service">
                    <StackPanel>
                        <CheckBox x:Name="chkAutoDiameter" Content="Diametre de nappe automatique"/>
                        <Grid IsEnabled="{Binding IsChecked, ElementName=chkAutoDiameter,
                                                  Converter={StaticResource Invert}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="185"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Diametre impose (mm)" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbDiameter" Grid.Column="1"/>
                        </Grid>
                        <CheckBox x:Name="chkTopBars"
                                  Content="Chapeaux aux appuis (encastrement partiel reel)"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Dispositions - ce qui n'est pas impose par la geometrie">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" FontSize="11"
                                   Foreground="#FF555555"
                                   Text="Chaque choix ci-dessous apparait dans la note de calcul avec sa raison. Les valeurs par defaut sont deduites de la geometrie et de la norme ; celles qui relevent de la pratique courante le disent."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="185"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Chapeaux" Style="{StaticResource FieldLabel}"
                                       ToolTip="Jusqu'ou vont les armatures superieures depuis le nu d'appui."/>
                            <ComboBox x:Name="cmbTopExtent" Grid.Row="0" Grid.Column="1"
                                      SelectionChanged="OnGeometryChanged">
                                <ComboBoxItem Content="Fraction de portee (pratique courante)"/>
                                <ComboBoxItem Content="Ancrage l_bd seul (minimum)"/>
                                <ComboBoxItem Content="Longueur imposee"/>
                                <ComboBoxItem Content="Nappe superieure continue"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Text="Fraction de portee" Style="{StaticResource FieldLabel}"
                                       ToolTip="0,25 = L/4. Ne releve d'aucun article : l'EC2 demande une enveloppe de moments."/>
                            <TextBox x:Name="txtTopFraction" Grid.Row="1" Grid.Column="1"/>

                            <TextBlock Grid.Row="2" Text="Longueur imposee (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtTopFixed" Grid.Row="2" Grid.Column="1"/>

                            <TextBlock Grid.Row="3" Text="Detail du noeud" Style="{StaticResource FieldLabel}"
                                       ToolTip="Angle rentrant tendu : aucune variante suivant le pli n'est proposee."/>
                            <ComboBox x:Name="cmbKneeDetail" Grid.Row="3" Grid.Column="1"
                                      SelectionChanged="OnGeometryChanged">
                                <ComboBoxItem Content="Nappes croisees"/>
                                <ComboBoxItem Content="Epingle diagonale separee"/>
                            </ComboBox>

                            <TextBlock Grid.Row="4" Text="Ancrage au noeud x l_bd" Style="{StaticResource FieldLabel}"
                                       ToolTip="Majorable, jamais reductible : un coefficient inferieur a 1 est refuse."/>
                            <TextBox x:Name="txtKneeFactor" Grid.Row="4" Grid.Column="1"/>

                            <TextBlock Grid.Row="5" Text="Barre de stock (mm)" Style="{StaticResource FieldLabel}"
                                       ToolTip="Au-dela, le moteur signale qu'il faut recouvrir. Il ne decoupe pas."/>
                            <TextBox x:Name="txtStockLength" Grid.Row="5" Grid.Column="1"/>

                            <TextBlock Grid.Row="6" Text="Arrondi des longueurs (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtRounding" Grid.Row="6" Grid.Column="1"/>
                        </Grid>
                        <CheckBox x:Name="chkDistributionAbove"
                                  Content="Repartition au-dessus des porteuses (hauteur utile maximale)"/>
                        <CheckBox x:Name="chkPartitions"
                                  Content="Supporte des cloisons fragiles (correction de fleche)"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="185"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Fissuration w_max (mm)" Style="{StaticResource FieldLabel}"
                                       ToolTip="0 = valeur recommandee du tableau 7.1N pour la classe d'exposition."/>
                            <TextBox x:Name="txtCrackWidth" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="270"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="grdResults" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                      SelectionChanged="OnResultSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Element" Binding="{Binding Element}" Width="1.7*"/>
                    <DataGridTextColumn Header="Marches" Binding="{Binding Marche}" Width="1.3*"/>
                    <DataGridTextColumn Header="Pente" Binding="{Binding Pente}" Width="0.8*"/>
                    <DataGridTextColumn Header="t (mm)" Binding="{Binding Paillasse}" Width="0.8*"/>
                    <DataGridTextColumn Header="Portee" Binding="{Binding Portee}" Width="0.9*"/>
                    <DataGridTextColumn Header="g (kN/m2)" Binding="{Binding Charge}" Width="1*"/>
                    <DataGridTextColumn Header="M (kN.m/m)" Binding="{Binding Moment}" Width="1.1*"/>
                    <DataGridTextColumn Header="Nappe inf." Binding="{Binding NappeInferieure}" Width="1.3*"/>
                    <DataGridTextColumn Header="Repartition" Binding="{Binding Repartition}" Width="1.3*"/>
                    <DataGridTextColumn Header="Chapeaux" Binding="{Binding Chapeaux}" Width="1.2*"/>
                    <DataGridTextColumn Header="Noeud" Binding="{Binding Noeud}" Width="0.8*"/>
                    <DataGridTextColumn Header="Acier (kg)" Binding="{Binding Poids}" Width="1*"/>
                    <DataGridTextColumn Header="Taux" Binding="{Binding Utilisation}" Width="0.7*"/>
                    <DataGridTextColumn Header="Geometrie" Binding="{Binding Geometrie}" Width="1.1*"/>
                    <DataGridTextColumn Header="Etat" Binding="{Binding Etat}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <GroupBox Grid.Row="1" Header="Note de calcul" Margin="0,10,0,0">
                <TextBox x:Name="txtNotes" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                         Background="#FFFAFAFA" BorderThickness="0"/>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="2" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Volee selectionnee">
                <Image x:Name="imgStair" Stretch="Uniform" SnapsToDevicePixels="True"/>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="Quantitatif">
                <TextBlock x:Name="txtQuantities" TextWrapping="Wrap" LineHeight="18"
                           Text="Cliquez sur Calculer."/>
            </GroupBox>
        </Grid>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="txtStatus" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="#FF444444"/>
            <Button x:Name="btnClose" DockPanel.Dock="Right" Content="Fermer" Width="100" Height="30"
                    Margin="8,0,0,0" Click="OnCloseClick"/>
            <Button x:Name="btnGenerate" DockPanel.Dock="Right" Content="Generer les armatures"
                    Width="175" Height="30" Margin="8,0,0,0" IsDefault="True" Click="OnGenerateClick"/>
            <Button x:Name="btnExport" DockPanel.Dock="Right" Content="Exporter la note"
                    Width="135" Height="30" Margin="8,0,0,0" Click="OnExportClick"/>
            <Button x:Name="btnCalculate" DockPanel.Dock="Right" Content="Calculer"
                    Width="105" Height="30" Margin="8,0,0,0" Click="OnCalculateClick"/>
        </DockPanel>
    </Grid>
</Window>
