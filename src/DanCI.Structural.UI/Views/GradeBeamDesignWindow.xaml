<Window x:Class="DanCI.Structural.UI.Views.GradeBeamDesignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DanCI.Structural.UI.Converters"
        Title="DanCI Structural Studio - Grade Beam Design" Height="860" Width="1390"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <local:InverseBooleanConverter x:Key="Invert"/>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="3,2,3,2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="375"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel>

                <GroupBox Header="Norme et materiaux">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Annexe Nationale" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbAnnex" Grid.Row="0" Grid.Column="1" SelectedIndex="0">
                            <ComboBoxItem Content="Valeurs recommandees EN 1992-1-1"/>
                            <ComboBoxItem Content="Annexe Nationale francaise (a completer)"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Text="Beton f_ck (MPa)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtFck" Grid.Row="1" Grid.Column="1"/>

                        <TextBlock Grid.Row="2" Text="Acier f_yk (MPa)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtFyk" Grid.Row="2" Grid.Column="1"/>

                        <TextBlock Grid.Row="3" Text="Poids beton (kN/m3)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtUnitWeight" Grid.Row="3" Grid.Column="1"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Appui et charges">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Conditions d'appui" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbSpanKind" Grid.Row="0" Grid.Column="1"
                                      SelectionChanged="OnInputChanged">
                                <ComboBoxItem Content="Travee isostatique"/>
                                <ComboBoxItem Content="Travee de rive"/>
                                <ComboBoxItem Content="Travee intermediaire"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Text="Repose sur" Style="{StaticResource FieldLabel}"
                                       ToolTip="Suspendue, elle porte toute sa charge. Le moteur ne prend jamais credit d'un appui du sol."/>
                            <ComboBox x:Name="cmbBedding" Grid.Row="1" Grid.Column="1"
                                      SelectionChanged="OnInputChanged">
                                <ComboBoxItem Content="Suspendue (vide, remblai compressible)"/>
                                <ComboBoxItem Content="Posee sur le sol"/>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Text="Charge de mur (kN/m)" Style="{StaticResource FieldLabel}"
                                       ToolTip="Valeur de calcul a l'ELU."/>
                            <TextBox x:Name="txtWallLoad" Grid.Row="2" Grid.Column="1"/>

                            <TextBlock Grid.Row="3" Text="Sol admissible (kPa)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtBearing" Grid.Row="3" Grid.Column="1"/>
                        </Grid>
                        <CheckBox x:Name="chkSelfWeight" Content="Inclure le poids propre (pondere a 1,35)"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Effort de liaison">
                    <StackPanel>
                        <CheckBox x:Name="chkSeismic" Content="Dimensionnement sismique (EN 1998)"
                                  Checked="OnSeismicChanged" Unchecked="OnSeismicChanged"
                                  ToolTip="Hors seisme, l'EN 1992 seul n'impose aucun effort de liaison."/>
                        <Grid x:Name="grdSeismic">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Classe de sol" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbGround" Grid.Row="0" Grid.Column="1">
                                <ComboBoxItem Content="A - rocher (aucune liaison exigee)"/>
                                <ComboBoxItem Content="B - depots tres denses"/>
                                <ComboBoxItem Content="C - sable dense a moyen"/>
                                <ComboBoxItem Content="D - sol lache"/>
                                <ComboBoxItem Content="E - alluvions sur substratum"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Text="a_g / g" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtAlpha" Grid.Row="1" Grid.Column="1"/>

                            <TextBlock Grid.Row="2" Text="Coefficient de sol S" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtSoilFactor" Grid.Row="2" Grid.Column="1"/>

                            <TextBlock Grid.Row="3" Text="N_Ed moyen poteaux (kN)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtMeanColumn" Grid.Row="3" Grid.Column="1"/>

                            <TextBlock Grid.Row="4" Text="Nombre de niveaux" Style="{StaticResource FieldLabel}"
                                       ToolTip="Fixe la hauteur minimale de l'art. 5.8.1(4)."/>
                            <TextBox x:Name="txtStoreys" Grid.Row="4" Grid.Column="1"/>
                        </Grid>

                        <Grid x:Name="grdManualTie">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Liaison imposee (kN)" Style="{StaticResource FieldLabel}"
                                       ToolTip="Si le projet en exige une au titre de la robustesse (EN 1991-1-7) ou d'un DTU."/>
                            <TextBox x:Name="txtManualTie" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Enrobage et durabilite">
                    <StackPanel>
                        <CheckBox x:Name="chkAutoCover" Content="Enrobage calcule (EC2 4.4.1)"/>
                        <Grid IsEnabled="{Binding IsChecked, ElementName=chkAutoCover}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Classe d'exposition" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbExposure" Grid.Column="1">
                                <ComboBoxItem Content="X0 - aucun risque"/>
                                <ComboBoxItem Content="XC1 - sec ou humide en permanence"/>
                                <ComboBoxItem Content="XC2 - humide, rarement sec"/>
                                <ComboBoxItem Content="XC3 - humidite moderee"/>
                                <ComboBoxItem Content="XC4 - alternance humide / sec"/>
                                <ComboBoxItem Content="XD1 - chlorures, humidite moderee"/>
                                <ComboBoxItem Content="XD2 - chlorures, humide"/>
                                <ComboBoxItem Content="XD3 - chlorures, alternance"/>
                                <ComboBoxItem Content="XS1 - air marin"/>
                                <ComboBoxItem Content="XS2 - immersion marine"/>
                                <ComboBoxItem Content="XS3 - zone de marnage"/>
                            </ComboBox>
                        </Grid>
                        <CheckBox x:Name="chkAgainstSoil"
                                  Content="Coulee directement contre le sol (75 mm au lieu de 40)"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Enrobage impose (mm)" Style="{StaticResource FieldLabel}"
                                       IsEnabled="{Binding IsChecked, ElementName=chkAutoCover,
                                                           Converter={StaticResource Invert}}"/>
                            <TextBox x:Name="txtCover" Grid.Column="1"
                                     IsEnabled="{Binding IsChecked, ElementName=chkAutoCover,
                                                         Converter={StaticResource Invert}}"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Ferraillage">
                    <StackPanel>
                        <CheckBox x:Name="chkAutoDiameter" Content="Diametre longitudinal automatique"/>
                        <Grid IsEnabled="{Binding IsChecked, ElementName=chkAutoDiameter,
                                                  Converter={StaticResource Invert}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Diametre impose (mm)" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbDiameter" Grid.Column="1"/>
                        </Grid>

                        <CheckBox x:Name="chkAutoStirrup" Content="Diametre de cadre automatique"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Diametre cadre (mm)" Style="{StaticResource FieldLabel}"
                                       IsEnabled="{Binding IsChecked, ElementName=chkAutoStirrup,
                                                           Converter={StaticResource Invert}}"/>
                            <ComboBox x:Name="cmbStirrupDiameter" Grid.Row="0" Grid.Column="1"
                                      IsEnabled="{Binding IsChecked, ElementName=chkAutoStirrup,
                                                          Converter={StaticResource Invert}}"/>
                            <TextBlock Grid.Row="1" Text="Brins par cadre" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtLegs" Grid.Row="1" Grid.Column="1"/>
                            <TextBlock Grid.Row="2" Text="Lits maximum" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtMaxLayers" Grid.Row="2" Grid.Column="1"/>
                            <TextBlock Grid.Row="3" Text="Granulat d_g (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtAggregate" Grid.Row="3" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="270"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="grdResults" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                      SelectionChanged="OnResultSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Element" Binding="{Binding Element}" Width="1.7*"/>
                    <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="1.2*"/>
                    <DataGridTextColumn Header="Portee" Binding="{Binding Portee}" Width="0.9*"/>
                    <DataGridTextColumn Header="w (kN/m)" Binding="{Binding Charge}" Width="1*"/>
                    <DataGridTextColumn Header="M (kN.m)" Binding="{Binding Moment}" Width="1*"/>
                    <DataGridTextColumn Header="Liaison (kN)" Binding="{Binding Liaison}" Width="1.1*"/>
                    <DataGridTextColumn Header="Nappe inf." Binding="{Binding NappeInferieure}" Width="1.3*"/>
                    <DataGridTextColumn Header="Nappe sup." Binding="{Binding NappeSuperieure}" Width="1.3*"/>
                    <DataGridTextColumn Header="Cadres" Binding="{Binding Cadres}" Width="1.3*"/>
                    <DataGridTextColumn Header="Acier (kg)" Binding="{Binding Poids}" Width="1*"/>
                    <DataGridTextColumn Header="Taux" Binding="{Binding Utilisation}" Width="0.7*"/>
                    <DataGridTextColumn Header="Etat" Binding="{Binding Etat}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <GroupBox Grid.Row="1" Header="Note de calcul" Margin="0,10,0,0">
                <TextBox x:Name="txtNotes" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                         Background="#FFFAFAFA" BorderThickness="0"/>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="2" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Longrine selectionnee">
                <Image x:Name="imgBeam" Stretch="Uniform" SnapsToDevicePixels="True"/>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="Quantitatif">
                <TextBlock x:Name="txtQuantities" TextWrapping="Wrap" LineHeight="18"
                           Text="Cliquez sur Calculer."/>
            </GroupBox>
        </Grid>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="txtStatus" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="#FF444444"/>
            <Button x:Name="btnClose" DockPanel.Dock="Right" Content="Fermer" Width="100" Height="30"
                    Margin="8,0,0,0" Click="OnCloseClick"/>
            <Button x:Name="btnGenerate" DockPanel.Dock="Right" Content="Generer les armatures"
                    Width="175" Height="30" Margin="8,0,0,0" IsDefault="True" Click="OnGenerateClick"/>
            <Button x:Name="btnExport" DockPanel.Dock="Right" Content="Exporter la note"
                    Width="135" Height="30" Margin="8,0,0,0" Click="OnExportClick"/>
            <Button x:Name="btnCalculate" DockPanel.Dock="Right" Content="Calculer"
                    Width="105" Height="30" Margin="8,0,0,0" Click="OnCalculateClick"/>
        </DockPanel>
    </Grid>
</Window>
