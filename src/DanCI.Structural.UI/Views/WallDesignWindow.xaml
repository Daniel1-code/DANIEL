<Window x:Class="DanCI.Structural.UI.Views.WallDesignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DanCI.Structural.UI.Converters"
        Title="DanCI Structural Studio - Wall Design" Height="860" Width="1400"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <local:InverseBooleanConverter x:Key="Invert"/>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="3,2,3,2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="375"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel>

                <GroupBox Header="Norme et materiaux">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Annexe Nationale" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbAnnex" Grid.Row="0" Grid.Column="1" SelectedIndex="0">
                            <ComboBoxItem Content="Valeurs recommandees EN 1992-1-1"/>
                            <ComboBoxItem Content="Annexe Nationale francaise (a completer)"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Text="Beton f_ck (MPa)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtFck" Grid.Row="1" Grid.Column="1"/>

                        <TextBlock Grid.Row="2" Text="Acier f_yk (MPa)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtFyk" Grid.Row="2" Grid.Column="1"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Maintien et flambement">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Conditions de maintien" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbRestraint" Grid.Row="0" Grid.Column="1"
                                  SelectionChanged="OnInputChanged"
                                  ToolTip="Article 12.6.5.1. Un retour de voile ne raidit que s'il est proche.">
                            <ComboBoxItem Content="Tete et pied seulement"/>
                            <ComboBoxItem Content="Trois rives (un retour)"/>
                            <ComboBoxItem Content="Quatre rives (deux retours)"/>
                            <ComboBoxItem Content="Console, libre en tete"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Text="Distance b entre rives (mm)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtRestraintSpacing" Grid.Row="1" Grid.Column="1"
                                 ToolTip="0 = la longueur du voile. Ignoree sans maintien lateral."/>

                        <TextBlock Grid.Row="2" Text="Fluage phi_ef" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtCreep" Grid.Row="2" Grid.Column="1"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Sollicitations hors plan (par metre)">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="N (kN/m)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtAxial" Grid.Row="0" Grid.Column="1"/>

                        <TextBlock Grid.Row="1" Text="M hors plan (kN.m/m)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtOutOfPlane" Grid.Row="1" Grid.Column="1"
                                 ToolTip="0 = l'excentricite minimale de l'art. 6.1(4) prend le relais."/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Contreventement (voile entier)">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="V dans le plan (kN)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtInPlaneShear" Grid.Row="0" Grid.Column="1"/>

                        <TextBlock Grid.Row="1" Text="M dans le plan (kN.m)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtInPlaneMoment" Grid.Row="1" Grid.Column="1"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Enrobage et durabilite">
                    <StackPanel>
                        <CheckBox x:Name="chkAutoCover" Content="Enrobage calcule (EC2 4.4.1)"/>
                        <Grid IsEnabled="{Binding IsChecked, ElementName=chkAutoCover}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Classe d'exposition" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbExposure" Grid.Column="1">
                                <ComboBoxItem Content="X0 - aucun risque"/>
                                <ComboBoxItem Content="XC1 - sec ou humide en permanence"/>
                                <ComboBoxItem Content="XC2 - humide, rarement sec"/>
                                <ComboBoxItem Content="XC3 - humidite moderee"/>
                                <ComboBoxItem Content="XC4 - alternance humide / sec"/>
                                <ComboBoxItem Content="XD1 - chlorures, humidite moderee"/>
                                <ComboBoxItem Content="XD2 - chlorures, humide"/>
                                <ComboBoxItem Content="XD3 - chlorures, alternance"/>
                                <ComboBoxItem Content="XS1 - air marin"/>
                                <ComboBoxItem Content="XS2 - immersion marine"/>
                                <ComboBoxItem Content="XS3 - zone de marnage"/>
                            </ComboBox>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Enrobage impose (mm)" Style="{StaticResource FieldLabel}"
                                       IsEnabled="{Binding IsChecked, ElementName=chkAutoCover,
                                                           Converter={StaticResource Invert}}"/>
                            <TextBox x:Name="txtCover" Grid.Column="1"
                                     IsEnabled="{Binding IsChecked, ElementName=chkAutoCover,
                                                         Converter={StaticResource Invert}}"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Ferraillage">
                    <StackPanel>
                        <CheckBox x:Name="chkAutoVertical" Content="Diametre vertical automatique"/>
                        <Grid IsEnabled="{Binding IsChecked, ElementName=chkAutoVertical,
                                                  Converter={StaticResource Invert}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Diametre vertical (mm)" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbVerticalDiameter" Grid.Column="1"/>
                        </Grid>

                        <CheckBox x:Name="chkAutoHorizontal" Content="Diametre horizontal automatique"/>
                        <Grid IsEnabled="{Binding IsChecked, ElementName=chkAutoHorizontal,
                                                  Converter={StaticResource Invert}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Diametre horizontal (mm)" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbHorizontalDiameter" Grid.Column="1"/>
                        </Grid>

                        <CheckBox x:Name="chkEdgeBars" Content="Barres de rive aux extremites"
                                  ToolTip="Necessaires des que la flexion dans le plan tend une rive."/>
                        <Grid IsEnabled="{Binding IsChecked, ElementName=chkEdgeBars}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Nombre par extremite" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtEdgeCount" Grid.Row="0" Grid.Column="1"/>
                            <TextBlock Grid.Row="1" Text="Diametre de rive (mm)" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbEdgeDiameter" Grid.Row="1" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="270"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="grdResults" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                      SelectionChanged="OnResultSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Element" Binding="{Binding Element}" Width="1.7*"/>
                    <DataGridTextColumn Header="t (mm)" Binding="{Binding Epaisseur}" Width="0.7*"/>
                    <DataGridTextColumn Header="L (mm)" Binding="{Binding Longueur}" Width="0.8*"/>
                    <DataGridTextColumn Header="h (mm)" Binding="{Binding Hauteur}" Width="0.8*"/>
                    <DataGridTextColumn Header="lambda" Binding="{Binding Elancement}" Width="0.8*"/>
                    <DataGridTextColumn Header="2e ordre" Binding="{Binding SecondOrdre}" Width="1*"/>
                    <DataGridTextColumn Header="Verticaux" Binding="{Binding Verticaux}" Width="1.3*"/>
                    <DataGridTextColumn Header="Horizontaux" Binding="{Binding Horizontaux}" Width="1.3*"/>
                    <DataGridTextColumn Header="Rives" Binding="{Binding Rives}" Width="1.3*"/>
                    <DataGridTextColumn Header="Acier (kg)" Binding="{Binding Poids}" Width="1*"/>
                    <DataGridTextColumn Header="Taux" Binding="{Binding Utilisation}" Width="0.7*"/>
                    <DataGridTextColumn Header="Etat" Binding="{Binding Etat}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <GroupBox Grid.Row="1" Header="Note de calcul" Margin="0,10,0,0">
                <TextBox x:Name="txtNotes" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                         Background="#FFFAFAFA" BorderThickness="0"/>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="2" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Voile selectionne">
                <Image x:Name="imgWall" Stretch="Uniform" SnapsToDevicePixels="True"/>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="Quantitatif">
                <TextBlock x:Name="txtQuantities" TextWrapping="Wrap" LineHeight="18"
                           Text="Cliquez sur Calculer."/>
            </GroupBox>
        </Grid>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="txtStatus" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="#FF444444"/>
            <Button x:Name="btnClose" DockPanel.Dock="Right" Content="Fermer" Width="100" Height="30"
                    Margin="8,0,0,0" Click="OnCloseClick"/>
            <Button x:Name="btnGenerate" DockPanel.Dock="Right" Content="Generer les armatures"
                    Width="175" Height="30" Margin="8,0,0,0" IsDefault="True" Click="OnGenerateClick"/>
            <Button x:Name="btnExport" DockPanel.Dock="Right" Content="Exporter la note"
                    Width="135" Height="30" Margin="8,0,0,0" Click="OnExportClick"/>
            <Button x:Name="btnCalculate" DockPanel.Dock="Right" Content="Calculer"
                    Width="105" Height="30" Margin="8,0,0,0" Click="OnCalculateClick"/>
        </DockPanel>
    </Grid>
</Window>
