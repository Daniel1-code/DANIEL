<Window x:Class="DanCI.Structural.UI.Views.SlabDesignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DanCI.Structural.UI.Converters"
        Title="DanCI Structural Studio - Slab Design" Height="840" Width="1380"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <local:InverseBooleanConverter x:Key="Invert"/>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="3,2,3,2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="365"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel>

                <GroupBox Header="Norme et materiaux">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Annexe Nationale" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbAnnex" Grid.Row="0" Grid.Column="1" SelectedIndex="0">
                            <ComboBoxItem Content="Valeurs recommandees EN 1992-1-1"/>
                            <ComboBoxItem Content="Annexe Nationale francaise (a completer)"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Text="Beton f_ck (MPa)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtFck" Grid.Row="1" Grid.Column="1"/>

                        <TextBlock Grid.Row="2" Text="Acier f_yk (MPa)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtFyk" Grid.Row="2" Grid.Column="1"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Portee et appuis">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Conditions d'appui" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbSpanKind" Grid.Row="0" Grid.Column="1"
                                  SelectionChanged="OnSpanKindChanged"
                                  ToolTip="Fixe a la fois les moments estimes et le coefficient K de l'article 7.4.2.">
                            <ComboBoxItem Content="Dalle isostatique"/>
                            <ComboBoxItem Content="Travee de rive"/>
                            <ComboBoxItem Content="Travee intermediaire"/>
                            <ComboBoxItem Content="Console"/>
                        </ComboBox>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Actions">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Origine des moments" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbMomentSource" Grid.Column="1"
                                      SelectionChanged="OnMomentSourceChanged">
                                <ComboBoxItem Content="Calcules a partir des charges"/>
                                <ComboBoxItem Content="Saisis (analyse exterieure)"/>
                            </ComboBox>
                        </Grid>

                        <Grid x:Name="grdLoads">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="g additionnel (kN/m2)" Style="{StaticResource FieldLabel}"
                                       ToolTip="Revetements, cloisons reparties, faux plafond. Hors poids propre."/>
                            <TextBox x:Name="txtPermanent" Grid.Row="0" Grid.Column="1"/>

                            <TextBlock Grid.Row="1" Text="q exploitation (kN/m2)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtVariable" Grid.Row="1" Grid.Column="1"/>

                            <TextBlock Grid.Row="2" Text="Categorie d'usage" Style="{StaticResource FieldLabel}"
                                       ToolTip="Fixe psi_2, donc la combinaison quasi-permanente, donc fleche et fissuration."/>
                            <ComboBox x:Name="cmbCategory" Grid.Row="2" Grid.Column="1">
                                <ComboBoxItem Content="A - habitation"/>
                                <ComboBoxItem Content="B - bureaux"/>
                                <ComboBoxItem Content="C - lieux de reunion"/>
                                <ComboBoxItem Content="D - commerces"/>
                                <ComboBoxItem Content="E - stockage"/>
                                <ComboBoxItem Content="H - toiture non accessible"/>
                                <ComboBoxItem Content="Neige"/>
                                <ComboBoxItem Content="Vent"/>
                            </ComboBox>

                            <TextBlock Grid.Row="3" Text="Poids beton (kN/m3)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtUnitWeight" Grid.Row="3" Grid.Column="1"/>

                            <CheckBox x:Name="chkSelfWeight" Grid.Row="4" Grid.ColumnSpan="2"
                                      Content="Inclure le poids propre de la dalle"/>
                        </Grid>

                        <Grid x:Name="grdMoments">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="M travee (kN.m/m)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtSpanMoment" Grid.Row="0" Grid.Column="1"/>
                            <TextBlock Grid.Row="1" Text="M appui (kN.m/m)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtSupportMoment" Grid.Row="1" Grid.Column="1"/>
                            <TextBlock Grid.Row="2" Text="V (kN/m)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtShear" Grid.Row="2" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Enrobage et durabilite">
                    <StackPanel>
                        <CheckBox x:Name="chkAutoCover" Content="Enrobage calcule (EC2 4.4.1)"/>
                        <Grid IsEnabled="{Binding IsChecked, ElementName=chkAutoCover}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Classe d'exposition" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbExposure" Grid.Column="1">
                                <ComboBoxItem Content="X0 - aucun risque"/>
                                <ComboBoxItem Content="XC1 - sec ou humide en permanence"/>
                                <ComboBoxItem Content="XC2 - humide, rarement sec"/>
                                <ComboBoxItem Content="XC3 - humidite moderee"/>
                                <ComboBoxItem Content="XC4 - alternance humide / sec"/>
                                <ComboBoxItem Content="XD1 - chlorures, humidite moderee"/>
                                <ComboBoxItem Content="XD2 - chlorures, humide"/>
                                <ComboBoxItem Content="XD3 - chlorures, alternance"/>
                                <ComboBoxItem Content="XS1 - air marin"/>
                                <ComboBoxItem Content="XS2 - immersion marine"/>
                                <ComboBoxItem Content="XS3 - zone de marnage"/>
                            </ComboBox>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Enrobage impose (mm)" Style="{StaticResource FieldLabel}"
                                       IsEnabled="{Binding IsChecked, ElementName=chkAutoCover,
                                                           Converter={StaticResource Invert}}"/>
                            <TextBox x:Name="txtCover" Grid.Column="1"
                                     IsEnabled="{Binding IsChecked, ElementName=chkAutoCover,
                                                         Converter={StaticResource Invert}}"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Service et ferraillage">
                    <StackPanel>
                        <CheckBox x:Name="chkPartitions"
                                  Content="Supporte des cloisons fragiles (correction 7/l_eff)"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="w_max visee (mm)" Style="{StaticResource FieldLabel}"
                                       ToolTip="0 = valeur recommandee du tableau 7.1N selon la classe d'exposition."/>
                            <TextBox x:Name="txtCrackWidth" Grid.Column="1"/>
                        </Grid>

                        <CheckBox x:Name="chkAutoDiameter" Content="Diametre de nappe automatique"/>
                        <Grid IsEnabled="{Binding IsChecked, ElementName=chkAutoDiameter,
                                                  Converter={StaticResource Invert}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Diametre impose (mm)" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbDiameter" Grid.Column="1"/>
                        </Grid>

                        <CheckBox x:Name="chkTopReinforcement"
                                  Content="Poser des chapeaux sur appui"
                                  ToolTip="Automatique des qu'un moment negatif existe."/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="270"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="grdResults" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                      SelectionChanged="OnResultSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Element" Binding="{Binding Element}" Width="1.8*"/>
                    <DataGridTextColumn Header="h (mm)" Binding="{Binding Epaisseur}" Width="0.8*"/>
                    <DataGridTextColumn Header="Portee" Binding="{Binding Portee}" Width="0.9*"/>
                    <DataGridTextColumn Header="w (kN/m2)" Binding="{Binding Charge}" Width="1*"/>
                    <DataGridTextColumn Header="M (kN.m/m)" Binding="{Binding Moment}" Width="1*"/>
                    <DataGridTextColumn Header="Nappe" Binding="{Binding Nappe}" Width="1.4*"/>
                    <DataGridTextColumn Header="Repartition" Binding="{Binding Repartition}" Width="1.4*"/>
                    <DataGridTextColumn Header="Chapeaux" Binding="{Binding Chapeaux}" Width="1.3*"/>
                    <DataGridTextColumn Header="Fleche" Binding="{Binding Fleche}" Width="0.8*"/>
                    <DataGridTextColumn Header="Acier (kg)" Binding="{Binding Poids}" Width="1*"/>
                    <DataGridTextColumn Header="Taux" Binding="{Binding Utilisation}" Width="0.7*"/>
                    <DataGridTextColumn Header="Etat" Binding="{Binding Etat}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <GroupBox Grid.Row="1" Header="Note de calcul" Margin="0,10,0,0">
                <TextBox x:Name="txtNotes" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                         Background="#FFFAFAFA" BorderThickness="0"/>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="2" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Dalle selectionnee">
                <Image x:Name="imgSlab" Stretch="Uniform" SnapsToDevicePixels="True"/>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="Quantitatif">
                <TextBlock x:Name="txtQuantities" TextWrapping="Wrap" LineHeight="18"
                           Text="Cliquez sur Calculer."/>
            </GroupBox>
        </Grid>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="txtStatus" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="#FF444444"/>
            <Button x:Name="btnClose" DockPanel.Dock="Right" Content="Fermer" Width="100" Height="30"
                    Margin="8,0,0,0" Click="OnCloseClick"/>
            <Button x:Name="btnGenerate" DockPanel.Dock="Right" Content="Generer les armatures"
                    Width="175" Height="30" Margin="8,0,0,0" IsDefault="True" Click="OnGenerateClick"/>
            <Button x:Name="btnExport" DockPanel.Dock="Right" Content="Exporter la note"
                    Width="135" Height="30" Margin="8,0,0,0" Click="OnExportClick"/>
            <Button x:Name="btnCalculate" DockPanel.Dock="Right" Content="Calculer"
                    Width="105" Height="30" Margin="8,0,0,0" Click="OnCalculateClick"/>
        </DockPanel>
    </Grid>
</Window>
